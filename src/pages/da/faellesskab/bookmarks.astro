        border-bottom-color: rgba(55, 26, 118, 0.3);
    }

    .resources-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: var(--space-md);
    }

    .resource-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 2rem 1.5rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(247, 147, 26, 0.15);
        transition: all 0.3s ease;
    }

    .resource-card:hover {
        background: rgba(247, 147, 26, 0.08);
        border-color: var(--primary);
        transform: translateY(-3px);
    }

    .nostr-card {
        border-color: rgba(55, 26, 118, 0.25);
    }

    .nostr-card:hover {
        background: rgba(55, 26, 118, 0.1);
        border-color: #7b42d1;
    }

    .resource-logo-wrap {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.13);
        border-radius: 10px;
        padding: 6px;
    }

    .resource-logo {
        max-height: 44px;
        max-width: 44px;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .resource-name {
        color: var(--text-light);
        font-size: 0.85rem;
        font-weight: 500;
        opacity: 0.85;
        text-align: center;
        line-height: 1.3;
    }

    .resource-card > .resource-name:first-child {
        font-size: 0.9rem;
        font-weight: 600;
        opacity: 1;
    }

    .resource-desc {
        color: var(--text-light);
        font-size: 0.75rem;
        opacity: 0.6;
        text-align: center;
        line-height: 1.35;
        margin-top: -0.25rem;
    }

    .back-to-top {
        display: block;
        width: fit-content;
        margin: 3rem auto 0 auto;
        font-size: 0.9rem;
        font-weight: 500;
        color: rgba(247, 147, 26, 0.9);
        transition: opacity 0.3s ease;
    }

    .back-to-top:hover {
        opacity: 0.7;
    }

    @media (max-width: 567px) {
        .resources-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Search */
    .search-section {
        margin-bottom: 3.5rem;
    }

    /* Search row */
    .search-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        max-width: 700px;
    }

    .suggest-btn {
        white-space: nowrap;
        padding: 0.7rem 1.2rem;
        background: none;
        border: 1px solid rgba(247, 147, 26, 0.4);
        border-radius: 8px;
        color: var(--primary);
        font-size: 0.9rem;
        font-family: var(--font-body);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .suggest-btn:hover {
        background: rgba(247, 147, 26, 0.08);
        border-color: var(--primary);
    }

    /* Modal */
    .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .modal-backdrop.open {
        display: flex;
    }

    .modal-box {
        background: var(--background-card, #1a1a1a);
        border: 1px solid rgba(247, 147, 26, 0.2);
        border-radius: 14px;
        width: 100%;
        max-width: 480px;
        overflow: hidden;
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.1rem;
        color: var(--primary);
    }

    .modal-close {
        background: none;
        border: none;
        color: var(--text-light);
        font-size: 0.85rem;
        cursor: pointer;
        padding: 0.25rem;
        line-height: 1;
        transition: color 0.2s;
    }

    .modal-close:hover { color: var(--primary); }

    .modal-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .modal-intro {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-light);
        opacity: 0.7;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .form-group label {
        font-size: 0.8rem;
        color: var(--text-light);
        opacity: 0.8;
    }

    .required { color: var(--primary); }

    .form-group input,
    .form-group select {
        padding: 0.6rem 0.8rem;
        background: rgba(255,255,255,0.06);
        border: 1px solid var(--border, rgba(255,255,255,0.12));
        border-radius: 7px;
        color: var(--text);
        font-size: 0.9rem;
        font-family: var(--font-body);
        outline: none;
        transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: var(--primary);
    }

    .form-group select option {
        background: #1a1a1a;
    }

    .modal-actions {
        padding-top: 0.25rem;
    }

    .btn-send {
        width: 100%;
        padding: 0.75rem;
        background: var(--primary);
        border: none;
        border-radius: 8px;
        color: #000;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-send:hover { opacity: 0.85; }
    .btn-send:disabled { opacity: 0.5; cursor: not-allowed; }

    .modal-status {
        margin: 0;
        font-size: 0.85rem;
        text-align: center;
        min-height: 1.2em;
        color: var(--text-light);
    }

    .modal-status.success { color: #4caf7d; }
    .modal-status.error   { color: #e05252; }

    .search-icon {
        position: absolute;
        left: 0.9rem;
        font-size: 1.25rem;
        color: var(--primary);
        opacity: 0.5;
        pointer-events: none;
        line-height: 1;
    }

    .search-input {
        width: 100%;
        padding: 0.7rem 2.4rem 0.7rem 2.5rem;
        background: var(--background-card);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-size: 0.95rem;
        font-family: var(--font-body);
        outline: none;
        transition: border-color 0.2s ease;
    }

    .search-input::placeholder {
        color: var(--text-light);
    }

    .search-input:focus {
        border-color: var(--primary);
    }

    .search-clear {
        position: absolute;
        right: 0.8rem;
        background: none;
        border: none;
        color: var(--text-light);
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0;
        display: none;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .search-clear:hover {
        color: var(--primary);
    }

    .search-no-results {
        display: none;
        margin-top: 1rem;
        color: var(--text-light);
        font-size: 0.9rem;
    }

    .category-section.hidden {
        display: none;
    }

    .resource-card.hidden {
        display: none;
    }
</style>

<script is:inline>
    (function () {
        var input = document.getElementById("bookmark-search");
        var clearBtn = document.getElementById("search-clear");
        var noResults = document.getElementById("search-no-results");

        if (!input || !clearBtn || !noResults) return;

        function runSearch() {
            var q = input.value.trim().toLowerCase();
            clearBtn.style.display = q ? "inline" : "none";

            var sections = document.querySelectorAll(".category-section");
            var anyVisible = false;

            sections.forEach(function (section) {
                var cards = section.querySelectorAll(".resource-card");
                var sectionHasMatch = false;

                var heading = section.querySelector("h2");
                var headingText = heading ? heading.textContent.toLowerCase() : "";
                var headingMatch = !q || headingText.includes(q);

                cards.forEach(function (card) {
                    var name = card.querySelector(".resource-name");
                    var desc = card.querySelector(".resource-desc");
                    var nameText = name ? name.textContent.toLowerCase() : "";
                    var descText = desc ? desc.textContent.toLowerCase() : "";
                    var matches = !q || nameText.includes(q) || descText.includes(q) || headingMatch;
                    card.classList.toggle("hidden", !matches);
                    if (matches) sectionHasMatch = true;
                });

                section.classList.toggle("hidden", !sectionHasMatch);
                if (sectionHasMatch) anyVisible = true;
            });

            noResults.style.display = (anyVisible || !q) ? "none" : "block";
        }

        input.addEventListener("input", runSearch);

        clearBtn.addEventListener("click", function () {
            input.value = "";
            runSearch();
            input.focus();
        });
    })();
</script>

<script is:inline>
    // --- Modal: Foreslå ressource ---
    (function () {
        var GITHUB_REPO = "Mannohat/enogtyve-web";
        var GITHUB_LABEL = "ny-ressource";

        var openBtn  = document.getElementById("suggest-open");
        var closeBtn = document.getElementById("suggest-close");
        var modal    = document.getElementById("suggest-modal");
        var sendBtn  = document.getElementById("suggest-send");
        var status   = document.getElementById("modal-status");

        function openModal() {
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
            document.getElementById("f-navn").focus();
        }

        function closeModal() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
            status.textContent = "";
            status.className = "modal-status";
        }

        openBtn.addEventListener("click", openModal);
        closeBtn.addEventListener("click", closeModal);

        modal.addEventListener("click", function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeModal();
        });

        sendBtn.addEventListener("click", async function () {
            var navn        = document.getElementById("f-navn").value.trim();
            var url         = document.getElementById("f-url").value.trim();
            var kategori    = document.getElementById("f-kategori").value;
            var beskrivelse = document.getElementById("f-beskrivelse").value.trim();

            if (!navn || !url || !kategori || !beskrivelse) {
                status.textContent = "Udfyld venligst alle felter.";
                status.className = "modal-status error";
                return;
            }

            sendBtn.disabled = true;
            status.textContent = "Sender…";
            status.className = "modal-status";

            var body = [
                "### Navn på ressourcen", "", navn, "",
                "### URL", "", url, "",
                "### Kategori", "", kategori, "",
                "### Kort beskrivelse (på dansk)", "", beskrivelse,
            ].join("\n");

            try {
                var token = document.getElementById("suggest-modal").dataset.token;
                var res = await fetch(
                    "https://api.github.com/repos/" + GITHUB_REPO + "/issues",
                    {
                        method: "POST",
                        headers: {
                            "Authorization": "Bearer " + token,
                            "Content-Type": "application/json",
                            "Accept": "application/vnd.github+json",
                        },
                        body: JSON.stringify({
                            title: "[Ressource]: " + navn,
                            body: body,
                            labels: [GITHUB_LABEL],
                        }),
                    }
                );

                if (res.ok) {
                    status.textContent = "✓ Tak! Dit forslag er sendt til gennemgang.";
                    status.className = "modal-status success";
                    document.getElementById("f-navn").value = "";
                    document.getElementById("f-url").value = "";
                    document.getElementById("f-kategori").value = "";
                    document.getElementById("f-beskrivelse").value = "";
                    sendBtn.disabled = false;
                } else {
                    throw new Error("HTTP " + res.status);
                }
            } catch (err) {
                status.textContent = "Noget gik galt. Prøv igen senere.";
                status.className = "modal-status error";
                sendBtn.disabled = false;
            }
        });
    })();
</script>