---
import ResourcePageLayout from "../../../layouts/ResourcePageLayout.astro";
const ghToken = import.meta.env.PUBLIC_GH_ISSUES_TOKEN ?? "";
---

<ResourcePageLayout
    title="Bogmærker"
    description="En samling af de Bitcoin-ressourcer, værktøjer og links."
    lang="da"
>
    <section class="intro">
        <p>
            Man falder over en hjemmeside, en wallet eller andet som man synes
            er spændende. Måske deler man det med andre eller måske glemmer man
            det igen. Siden her er et forsøg på at samle disse og forhåbentlig
            gøre det overskueligt og nemt at finde frem til igen.
        </p>
    </section>

    <section class="search-section">
        <div class="search-row">
            <div class="search-wrap">
                <span class="search-icon">⌕</span>
                <input
                    type="text"
                    id="bookmark-search"
                    class="search-input"
                    placeholder="Søg blandt bogmærker…"
                    autocomplete="off"
                    spellcheck="false"
                />
                <button class="search-clear" id="search-clear" aria-label="Ryd søgning">✕</button>
            </div>
            <button class="suggest-btn" id="suggest-open">+ Foreslå ressource</button>
        </div>
        <p class="search-no-results" id="search-no-results">Ingen resultater fundet.</p>
    </section>

    <!-- Modal -->
    <div class="modal-backdrop" id="suggest-modal" aria-hidden="true" data-token={ghToken}>
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal-header">
                <h3 id="modal-title">Foreslå en ressource</h3>
                <button class="modal-close" id="suggest-close" aria-label="Luk">✕</button>
            </div>
            <div class="modal-body">
                <p class="modal-intro">Kender du en god Bitcoin-ressource der mangler her? Udfyld formularen og vi kigger på den.</p>

                <div class="form-group">
                    <label for="f-navn">Navn <span class="required">*</span></label>
                    <input type="text" id="f-navn" placeholder="fx Mempool.space" />
                </div>
                <div class="form-group">
                    <label for="f-url">URL <span class="required">*</span></label>
                    <input type="url" id="f-url" placeholder="https://..." />
                </div>
                <div class="form-group">
                    <label for="f-kategori">Kategori <span class="required">*</span></label>
                    <select id="f-kategori">
                        <option value="">Vælg kategori…</option>
                        <option>Essentielt</option>
                        <option>Nyheder</option>
                        <option>Lær om Bitcoin</option>
                        <option>Blockchain</option>
                        <option>Price tickers</option>
                        <option>Lightning</option>
                        <option>Wallets</option>
                        <option>Podcasts</option>
                        <option>Tutorials</option>
                        <option>Bøger</option>
                        <option>Musik</option>
                        <option>Værktøjer</option>
                        <option>Film & dokumentarer</option>
                        <option>Andre ressourcer</option>
                        <option>Kunst & kultur</option>
                        <option>Merch & shops</option>
                        <option>NOSTR</option>
                        <option>Køb Bitcoin</option>
                        <option>Mining</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="f-beskrivelse">Kort beskrivelse <span class="required">*</span></label>
                    <input type="text" id="f-beskrivelse" placeholder="Én sætning på dansk om hvad ressourcen er" maxlength="120" />
                </div>

                <div class="modal-actions">
                    <button class="btn-send" id="suggest-send">Send forslag</button>
                </div>
                <p class="modal-status" id="modal-status"></p>
            </div>
        </div>
    </div>

    <section class="category-section">
        <h2>Essentielt</h2>
        <div class="resources-grid">
            <a href="https://bitcoin.org/bitcoin.pdf?ref=enogtyve" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-logo-wrap">
                <img src="/images/logos/bitcoin.png" alt="Bitcoin Whitepaper" class="resource-logo" onerror="this.remove()"/>
                </div>
                <span class="resource-name">The Bitcoin Whitepaper</span>
                <span class="resource-desc">Satoshi Nakamotos originale 9-siders dokument fra 2008</span>
            </a>
            <a href="https://www.youtube.com/watch?v=ONvg9SbauMg" class="resource-card" target="_blank" rel="noopener noreferrer">
                <div class="resource-logo-wrap">
                <img src="https://icons.duckduckgo.com/ip3/youtube.com.ico" alt="The Stories We Tell About Money" class="resource-logo" onerror="this.remove()"/>
                </div>
                <span class="resource-name">The Stories We Tell About Money</span>
                <span class="resource-desc">Andreas Antonopoulos om penges natur og Bitcoin</span>
            </a>
            <a href="https://www.youtube.com/watch?v=Z9HbQsTgrtk" class="resource-card" target="_blank" rel="noopener noreferrer">
