        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 0.75rem;
        padding: 1.5rem 1.25rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(247, 147, 26, 0.15);
        transition: all 0.3s ease;
        height: 100%;
    }

    .resource-card:hover {
        background: rgba(247, 147, 26, 0.08);
        border-color: var(--primary);
        transform: translateY(-3px);
    }

    .nostr-card {
        border-color: rgba(55, 26, 118, 0.25);
    }

    .nostr-card:hover {
        background: rgba(55, 26, 118, 0.1);
        border-color: #7b42d1;
    }

    .resource-logo-wrap {
        height: 64px;
        width: 100%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        border-radius: 10px;
        padding: 10px;
    }

    .resource-logo {
        max-height: 44px;
        max-width: 96px;
        width: auto;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 1px rgba(0,0,0,0.15));
    }

    .resource-logo[src*="duckduckgo"] {
        max-height: 24px;
        max-width: 24px;
        width: 24px;
        height: 24px;
        object-fit: contain;
        filter: none;
    }

    .resource-name {
        color: var(--text-light);
        font-size: 0.85rem;
        font-weight: 500;
        opacity: 0.85;
        text-align: center;
        line-height: 1.3;
    }

    .resource-card > .resource-name:first-child {
        font-size: 0.9rem;
        font-weight: 600;
        opacity: 1;
    }

    .resource-desc {
        color: var(--text-light);
        font-size: 0.75rem;
        opacity: 0.6;
        text-align: center;
        line-height: 1.35;
        margin-top: auto;
