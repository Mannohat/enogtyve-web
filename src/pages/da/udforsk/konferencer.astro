---
import ResourcePageLayout from "../../../layouts/ResourcePageLayout.astro";
import { conferences, conferenceEventSchema } from "../../../data/events";

const today = new Date();
today.setHours(0, 0, 0, 0);

// Upcoming events first (soonest at top), then past events (most recent first).
// ISO date strings (YYYY-MM-DD) sort chronologically as plain strings.
const sortedConferences = [...conferences].sort((a, b) => {
  const aPast = new Date(a.endISO) < today;
  const bPast = new Date(b.endISO) < today;
  if (aPast !== bPast) return aPast ? 1 : -1;
  return aPast
    ? b.startISO.localeCompare(a.startISO)
    : a.startISO.localeCompare(b.startISO);
});

const eventSchema = conferenceEventSchema("da");
---

<script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

<ResourcePageLayout
  title="Bitcoin-konferencer"
  description="Overblik over Bitcoin-konferencer og events du kan deltage i."
  lang="da"
>
  <section class="content-section">
    <p>Deltagelse i en Bitcoin-konference er en god måde at lære nyt, møde andre Bitcoinere samt i det hele taget få en fornemmelse af, hvad der rører sig i og omkring Bitcoin. Husk også at tjekke de satellitbegivenheder, som ofte finder sted før og efter det officielle program.</p>
    <p>Som så ofte kan man mange steder opnå rabat med rabatkoden <strong>"enogtyve"</strong> — hold øje med 🎟️-markeringerne på konferencerne herunder.</p>
    <p>Efter at have deltaget i mange forskellige Bitcoin-konferencer er her et par anbefalinger:</p>
  </section>

  <section class="conferences-list">
    {sortedConferences.map((conf) => {
      const isPast = new Date(conf.endISO) < today;
      return (
        <div class:list={["conference-card", { past: isPast }]}>
          <a href={conf.url} target="_blank" rel="noopener noreferrer" class="conference-image-link">
            <img src={conf.image} alt={conf.name} class="conference-image" />
          </a>
          <div class="conference-content">
            <div class="conference-name-row">
              <h2 class="conference-name">{conf.name}</h2>
              {isPast && <span class="past-badge">Afholdt</span>}
            </div>
            <div class="conference-meta">
              <span class="conference-date">📅 {conf.timeLocation.da.split("·")[0].trim()}</span>
              <span class="conference-location">📍 {conf.location.da}</span>
            </div>
            <p class="conference-desc">{conf.description.da}</p>
            <div class="conference-actions">
              <a href={conf.url} target="_blank" rel="noopener noreferrer" class="conference-cta">
                {conf.linkLabel.da} →
              </a>
            </div>
            {conf.discount && (
              <p class="conference-discount">🎟️ {conf.discount.da}</p>
            )}
          </div>
        </div>
      );
    })}
  </section>

  <section class="overview-note">
    <p>Oversigt over flere Bitcoin-konferencer: <a href="https://bitcoin.review/bitcoin-events/" target="_blank" rel="noopener noreferrer"><strong>Bitcoin.review – Events →</strong></a></p>
  </section>

  <a href="#" class="back-to-top"> ↑ Tilbage til toppen </a>
</ResourcePageLayout>

<style>
  .content-section {
    margin-bottom: 2.5rem;
    line-height: 1.8;
    color: var(--text-light, #ccc);
  }

  .content-section p {
    margin-bottom: 0.75rem;
  }

  /* Conferences */
  .conferences-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .conference-card {
    display: flex;
    gap: 2rem;
    border: 1px solid rgba(247, 147, 26, 0.12);
    border-radius: 12px;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s ease;
  }

  .conference-card:hover {
    border-color: rgba(247, 147, 26, 0.3);
  }

  .conference-card.past {
    opacity: 0.6;
  }

  .conference-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .conference-name-row .conference-name {
    margin-bottom: 0;
  }

  .past-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-light);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  .conference-image-link {
    flex-shrink: 0;
    width: 220px;
    display: flex;
    align-items: flex-start;
  }

  .conference-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  .conference-image-link:hover .conference-image {
    opacity: 0.85;
  }

  .conference-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .conference-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-light, #ccc);
    margin: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .conference-meta {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .conference-date,
  .conference-location {
    font-size: 0.82rem;
    color: rgba(204, 204, 204, 0.6);
    font-weight: 600;
  }

  .conference-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(204, 204, 204, 0.7);
    margin: 0.25rem 0 0 0;
    flex-grow: 1;
  }

  .conference-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .conference-cta {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    background: rgba(247, 147, 26, 0.12);
    color: var(--primary);
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: 6px;
    transition: background 0.2s ease;
  }

  .conference-cta:hover {
    background: rgba(247, 147, 26, 0.22);
  }

  .conference-discount {
    font-size: 0.82rem;
    color: var(--primary);
    font-weight: 600;
    margin: 0.25rem 0 0 0;
    padding: 0.4rem 0.75rem;
    background: rgba(247, 147, 26, 0.06);
    border-radius: 6px;
    width: fit-content;
  }

  /* Overview note */
  .overview-note {
    margin-bottom: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(247, 147, 26, 0.04);
    border: 1px solid rgba(247, 147, 26, 0.12);
    border-radius: 10px;
    text-align: center;
    color: var(--text-light, #ccc);
  }

  .overview-note p {
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 567px) {
    .conference-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .conference-image-link {
      width: 100%;
      max-width: 280px;
    }

    .conference-meta {
      justify-content: center;
    }

    .conference-actions {
      justify-content: center;
    }

    .conference-discount {
      align-self: center;
    }
  }
</style>