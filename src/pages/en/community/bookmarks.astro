<script is:inline>
    (function () {
        var input = document.getElementById("bookmark-search");
        var clearBtn = document.getElementById("search-clear");
        var noResults = document.getElementById("search-no-results");

        if (!input || !clearBtn || !noResults) return;

        function runSearch() {
            var q = input.value.trim().toLowerCase();
            clearBtn.style.display = q ? "inline" : "none";

            var sections = document.querySelectorAll(".category-section");
            var anyVisible = false;

            sections.forEach(function (section) {
                var cards = section.querySelectorAll(".resource-card");
                var sectionHasMatch = false;

                var heading = section.querySelector("h2");
                var headingText = heading ? heading.textContent.toLowerCase() : "";
                var headingMatch = !q || headingText.includes(q);

                cards.forEach(function (card) {
                    var name = card.querySelector(".resource-name");
                    var desc = card.querySelector(".resource-desc");
                    var nameText = name ? name.textContent.toLowerCase() : "";
                    var descText = desc ? desc.textContent.toLowerCase() : "";
                    var matches = !q || nameText.includes(q) || descText.includes(q) || headingMatch;
                    card.classList.toggle("hidden", !matches);
                    if (matches) sectionHasMatch = true;
                });

                section.classList.toggle("hidden", !sectionHasMatch);
                if (sectionHasMatch) anyVisible = true;
            });

            noResults.style.display = (anyVisible || !q) ? "none" : "block";
        }

        input.addEventListener("input", runSearch);

        clearBtn.addEventListener("click", function () {
            input.value = "";
            runSearch();
            input.focus();
        });
    })();
</script>

<script is:inline>
    (function () {
        var GITHUB_REPO = "Mannohat/enogtyve-web";
        var GITHUB_LABEL = "ny-ressource";

        var openBtn  = document.getElementById("suggest-open");
        var closeBtn = document.getElementById("suggest-close");
        var modal    = document.getElementById("suggest-modal");
        var sendBtn  = document.getElementById("suggest-send");
        var status   = document.getElementById("modal-status");

        function openModal() {
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
            document.getElementById("f-navn").focus();
        }

        var lukBtn    = document.getElementById("suggest-luk");
        var enMereBtn = document.getElementById("suggest-en-mere");
        var postActions = document.getElementById("modal-post-actions");

        function closeModal() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
            status.textContent = "";
            status.className = "modal-status";
            postActions.style.display = "none";
        }

        openBtn.addEventListener("click", openModal);
        closeBtn.addEventListener("click", closeModal);
        lukBtn.addEventListener("click", closeModal);
        enMereBtn.addEventListener("click", function() {
            postActions.style.display = "none";
            sendBtn.style.display = "block";
            status.textContent = "";
            status.className = "modal-status";
        });

        modal.addEventListener("click", function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeModal();
        });

        sendBtn.addEventListener("click", async function () {
            var navn        = document.getElementById("f-navn").value.trim();
            var url         = document.getElementById("f-url").value.trim();
            var kategori    = document.getElementById("f-kategori").value;
            var beskrivelse = document.getElementById("f-beskrivelse").value.trim();

            if (!navn || !url || !kategori || !beskrivelse) {
                status.textContent = "Please fill in all fields.";
                status.className = "modal-status error";
                return;
            }

            sendBtn.disabled = true;
            status.textContent = "Sending…";
            status.className = "modal-status";

            try {
                var res = await fetch("/.netlify/functions/create-issue", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        navn: navn,
                        url: url,
                        kategori: kategori,
                        beskrivelse: beskrivelse,
                        labels: [GITHUB_LABEL],
                    }),
                });

                if (res.ok) {
                    status.textContent = "✓ Thanks! Your suggestion has been sent for review.";
                    status.className = "modal-status success";
                    document.getElementById("f-navn").value = "";
                    document.getElementById("f-url").value = "";
                    document.getElementById("f-kategori").value = "";
                    document.getElementById("f-beskrivelse").value = "";
                    sendBtn.disabled = false;
                    postActions.style.display = "flex";
                    sendBtn.style.display = "none";
                } else {
                    throw new Error("HTTP " + res.status);
                }
            } catch (err) {
                status.textContent = "Something went wrong. Please try again later.";
                status.className = "modal-status error";
                sendBtn.disabled = false;
            }
        });
    })();
</script>