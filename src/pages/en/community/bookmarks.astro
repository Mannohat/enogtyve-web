---
import ResourcePageLayout from "../../../layouts/ResourcePageLayout.astro";
---

<ResourcePageLayout
    title="Bookmarks"
    description="Curated Bitcoin resources and bookmarks — wallets, nodes, exchanges, books, podcasts, films, and much more."
    lang="en"
>
    <section class="intro">
        <p>
            You stumble across a website, a wallet, or something else you find
            exciting. Maybe you share it with others, or maybe you forget about it
            again. This page is an attempt to gather these and hopefully make them
            easy to overview and find again — or simply to explore.
        </p>
    </section>

    <section class="search-section">
        <div class="search-row">
            <div class="search-wrap">
                <span class="search-icon">⌕</span>
                <input
                    type="text"
                    id="bookmark-search"
                    class="search-input"
                    placeholder="Search the bookmarks…"
                    autocomplete="off"
                    spellcheck="false"
                />
                <button class="search-clear" id="search-clear" aria-label="Clear search">✕</button>
            </div>
            <button class="suggest-btn" id="suggest-open">+ Suggest a resource</button>
        </div>
        <p class="search-no-results" id="search-no-results">No results found.</p>
    </section>

    <!-- Modal -->
    <div class="modal-backdrop" id="suggest-modal" aria-hidden="true">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal-header">
                <h3 id="modal-title">Suggest a resource</h3>
                <button class="modal-close" id="suggest-close" aria-label="Close">✕</button>
            </div>
            <div class="modal-body">
                <p class="modal-intro">Do you know a good Bitcoin resource that's missing here? Fill in the form and we'll take a look.</p>
                <div class="form-group">
                    <label for="f-navn">Name <span class="required">*</span></label>
                    <input type="text" id="f-navn" placeholder="e.g. Mempool.space" />
                </div>
                <div class="form-group">
                    <label for="f-url">URL <span class="required">*</span></label>
                    <input type="url" id="f-url" placeholder="https://..." />
                </div>
                <div class="form-group">
                    <label for="f-kategori">Category <span class="required">*</span></label>
                    <select id="f-kategori">
                        <option value="">Choose a category…</option>
                        <option>Essential</option>
                        <option>Learn about Bitcoin</option>
                        <option>Books</option>
                        <option>Tutorials</option>
                        <option>Podcasts</option>
                        <option>Films &amp; documentaries</option>
                        <option>News</option>
                        <option>Blockchain</option>
                        <option>Price tickers</option>
                        <option>Wallets</option>
                        <option>Hardware Wallets</option>
                        <option>Lightning</option>
                        <option>Liquid</option>
                        <option>eCash</option>
                        <option>Ark</option>
                        <option>Node &amp; Infrastructure</option>
                        <option>Buy Bitcoin</option>
                        <option>Earn Bitcoin</option>
                        <option>Mining</option>
                        <option>Conferences</option>
                        <option>Meet other Bitcoiners</option>
                        <option>Tools</option>
                        <option>Music</option>
                        <option>Art &amp; culture</option>
                        <option>Entertainment</option>
                        <option>Health and Wellbeing</option>
                        <option>Merch &amp; shops</option>
                        <option>Other resources</option>
                        <option>NOSTR</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="f-beskrivelse">Short description <span class="required">*</span></label>
                    <input type="text" id="f-beskrivelse" placeholder="One sentence about what the resource is" maxlength="120" />
                </div>
                <div class="modal-actions">
                    <button class="btn-send" id="suggest-send">Send suggestion</button>
                </div>
                <p class="modal-status" id="modal-status"></p>
                <div class="modal-post-actions" id="modal-post-actions" style="display:none">
                    <button class="btn-luk" id="suggest-luk">Close</button>
                    <button class="btn-en-mere" id="suggest-en-mere">Suggest another?</button>
                </div>
            </div>
        </div>
    </div>

