        logo: "/images/logos/bitcoinskolen.png",
      },
      {
        name: "Bitcoin Forklaret: Teknologi, Økonomi, Politik og Filosofi",
        url: "https://bitcoin-grundbog.pplx.app/",
        info: "Danish online primer — Bitcoin as digital public infrastructure for money, explained through technology, economics, politics, and philosophy (in Danish)",
        support: "",
        logo: "/images/logos/bitcoinforklaret.png",
      },
    ],
  },
  {
    title: "Translations",
    icon: "/images/icons/translate.png",
    items: [
      {
        name: "The Bitcoin Standard in Danish",
        url: "https://www.bitcoinstandarden.dk",
        info: 'Saifedean\'s "The Bitcoin Standard" translated into Danish',
        support: "",
        logo: "/images/icons/books.png",
      },
      {
        name: "Mempool.space in Danish",
        url: "https://www.mempool.space",
        info: "Probably the most widely used Bitcoin blockchain explorer, translated into Danish",
        support: "",
        logo: "/images/logos/mempool.png",
      },
      {
        name: "Blink Wallet in Danish",
        url: "https://www.blink.sv",
        info: "An incredibly easy and user-friendly Bitcoin wallet with a wide range of features, translated into Danish",
        support: "slybtc@getalby.com",
        logo: "/images/logos/blink.png",
      },
      {
        name: 'Gigi\'s "Dear family, dear friends"',
        url: "https://archive.ph/P6uNk",
        info: 'Gigi\'s "Dear family, dear friends" translated into Danish',
        support: "",
        logo: "/images/icons/article.png",
      },
      {
        name: "Shop21.dk",
        url: "https://shop21.dk/?ref=enogtyve.org",
        info: "Danish books about Bitcoin, freedom, and more",
        support: "",
        logo: "/images/logos/shop21.png",
      },
    ],
  },
  {
    title: "Books & material",
    icon: "/images/icons/books.png",
    items: [
      {
        name: "Shop21.dk",
        url: "https://shop21.dk/?ref=enogtyve.org",
        info: "Danish books about Bitcoin, freedom, and more",
        support: "",
        logo: "/images/logos/shop21.png",
      },
      {
        name: "Why Bitcoin?",
        url: "https://drive.google.com/file/d/1APSqzg21MjnejallrKeRf16BB1OqLZwz/view",
        info: "A small Danish handbook on how Bitcoin, as a new technology, can help the world, the climate, society, and the future of you and your family",
        support: "",
        logo: "/images/logos/bitcoinskolen.png",
      },
      {
        name: "Bitcoin leaflet",
        url: "/pdf/21-HURTIGE.pdf",
        info: "A leaflet with 21 quick explanations and answers about Bitcoin",
