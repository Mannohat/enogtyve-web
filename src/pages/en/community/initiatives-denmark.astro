        logo: "/images/logos/shop21.png",
      },
    ],
  },
  {
    title: "Health and Wellbeing",
    icon: "/images/icons/love.png",
    items: [
      {
        name: "SAUNA.",
        url: "https://sauna.lyn.page?ref=enogtyve",
        info: "Danish sauna concept built on modular design — seven modules. one sauna.",
        support: "",
        logo: "/images/logos/lynsauna.png",
      },
    ],
  },
  {
