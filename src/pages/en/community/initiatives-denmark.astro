        logo: "/images/logos/barekev.png",
      },
      {
        name: "A World of Falling Prices",
        url: localizedHref("/da/blog/en-verden-med-faldende-priser", "en"),
        info: "A blog post covering a range of challenges along with an introduction to how Bitcoin can be the solution",
        support: "barekev@walletofsatoshi.com",
        logo: "/images/logos/barekev.png",
      },
    ],
  },
  {
    title: "Reference works",
    icon: "/images/icons/lookup.png",
    items: [
      {
        name: "Words & Terms",
        url: "/en/get-started/terms-and-words",
        info: "Glossary of Bitcoin and economics terms in Danish",
        support: "",
        logo: "/images/icons/lookup.png",
      },
    ],
  },
  {
    title: "Web shops",
    icon: "/images/icons/merch.png",
    items: [
      {
        name: "Shop21.dk",
        url: "https://shop21.dk/?ref=enogtyve.org",
        info: "Danish books about Bitcoin, freedom, and more",
