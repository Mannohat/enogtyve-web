const upcoming = [
  {
    name: "Shelling Out",
    type: "Translation",
    info: "Nick Szabo article about the history of money",
    support: "slybtc@getalby.com",
  },
];
---

<ResourcePageLayout
  title="Bitcoin initiatives in Denmark"
  description="An overview of Bitcoin initiatives, projects, and communities in Denmark."
  lang="en"
>
  <section class="content-section intro">
    <div class="intro-grid">
      <div>
        <h2>Proof of Work</h2>
        <p>
          On this page you'll find Bitcoin-only initiatives that all contribute to
          a better and broader understanding of what Bitcoin is.
        </p>
        <p>
          If you appreciate some of these initiatives, consider sending a few sats
          to the people behind them, or perhaps ask whether you can help them.
          You'll find a Lightning address next to several of these initiatives.
        </p>
        <p>
          If you have ideas and the means to take the initiative yourself, consider
          it. Bitcoin is Proof of Work.
        </p>
      </div>
      <div class="intro-image">
        <Image src="/images/icons/pow.png" alt="" width={1024} height={1024} />
      </div>
    </div>
  </section>

  <section class="content-section">
    <p>
      Do you know a Danish Bitcoin-only initiative that you think is missing from
      the list? Send an email to <a href="mailto:kontakt@enogtyve.org"
        ><strong>kontakt@enogtyve.org</strong></a
      > or hop into the "Proof of Work" thread on Telegram: <a
        href="https://t.me/enogtyvedk/7560"
        target="_blank"
        rel="noopener noreferrer"><strong>Enogtyve Proof of Work</strong></a
      >.
    </p>
  </section>

  {
    categories.map((cat) => (
      <section class="category-section">
        <h2>
          <img src={cat.icon} alt="" class="cat-icon" /> {cat.title}
        </h2>
        <div class="initiatives-grid">
          {cat.items.map((item) => (
            <div class="initiative-card">
              <div class="card-logo">
                {item.logo ? (
                  <img src={item.logo} alt="" />
                ) : (
                  <Image src="/images/icons/strong.png" alt="" width={1024} height={1024} />
                )}
              </div>
              {item.url.startsWith("/") ? (
                <a href={item.url} class="card-name">
                  {item.name}
                </a>
              ) : item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-name"
                >
                  {item.name}
                </a>
              ) : (
                <span class="card-name">{item.name}</span>
              )}
              <p class="card-info">{item.info}</p>
              {item.support && (
                <div class="card-support">
                  <span class="support-label">{item.support.includes("@") ? "⚡" : "🌐"}</span>
                  <code>{item.support}</code>
                  <button
                    class="copy-btn"
                    data-copy={item.support}
                    aria-label="Copy to clipboard"
                    title="Copy"
                  >
                    <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                    <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="category-section upcoming-section">
    <h2>
      <Image src="/images/icons/underconstruction.png" alt="" width={1024} height={1024} class="cat-icon" /> In
      progress
    </h2>
    <p class="upcoming-note">
      Below are initiatives being worked on. This list may well be out of date —
      ask in the <a
        href="https://t.me/enogtyvedk/7560"
        target="_blank"
        rel="noopener noreferrer"><strong>"Proof of Work" thread</strong></a
      > on Telegram.
    </p>
    <div class="initiatives-grid">
      {
        upcoming.map((item) => (
          <div class="initiative-card upcoming">
            <div class="card-logo">
              <Image src="/images/icons/timeglas.png" alt="" width={1024} height={1024} />
            </div>
            <div class="card-top-row">
              <span class="card-name">{item.name}</span>
              <span class="upcoming-badge">{item.type}</span>
            </div>
            <p class="card-info">{item.info}</p>
            {item.support && (
              <div class="card-support">
                <span class="support-label">{item.support.includes("@") ? "⚡" : "🌐"}</span>
                <code>{item.support}</code>
                <button
                  class="copy-btn"
                  data-copy={item.support}
                  aria-label="Copy to clipboard"
                  title="Copy"
                >
                  <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                  <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                </button>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="content-section">
    <h2>Help with translations</h2>
    <p>
      If you'd like to help translate learning material, there's plenty of
      opportunity, and in some cases you can earn sats for your effort. That said,
      it should be a labor of love, as the amounts are usually small and symbolic.
    </p>
    <p>
      Better tools for translation are constantly being developed, and there are
      several initiatives where you can get advice on how to tackle a translation
      task most effectively:
    </p>
    <div class="resource-links">
      <a
        href="https://t.me/enogtyvedk/7560"
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link">ENOGTYVE Proof of work</a
      >
      <a
        href="https://planb.network/"
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link">Planb.network →</a
      >
      <a
        href="https://www.blink.sv/en/blog/adoption"
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link">Blink Blog →</a
      >
    </div>
    <p style="margin-top: 1rem;">
      You can also contribute directly to this website via GitHub — for example
      with blog posts, fixes, or bug reports:
    </p>
    <div class="resource-links">
      <a
        href="https://github.com/Mannohat/enogtyve-web"
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link">GitHub – enogtyve-web →</a
      >
    </div>
  </section>

  <section class="content-section cta-section">
    <a
      href="https://t.me/enogtyvedk/7560"
      target="_blank"
      rel="noopener noreferrer"
      class="cta-link"
    >
      Don't hesitate to write or ask questions in the Enogtyve Proof of Work group →
    </a>
  </section>

  <a href="#" class="back-to-top"> ↑ Back to top </a>
</ResourcePageLayout>

<style>
  .content-section {
    margin-bottom: 2.5rem;
    line-height: 1.8;
    color: var(--text-light, #ccc);
  }

  .content-section p {
    margin-bottom: 0.75rem;
  }

  .content-section h2 {
    font-size: 1.3rem;
    color: var(--primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(247, 147, 26, 0.2);
  }

  .intro h2 {
    font-size: 1.8rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .intro-image img {
    width: 100%;
    max-width: 250px;
    height: auto;
    margin-left: auto;
    display: block;
    opacity: 0.85;
  }

  .category-section {
    margin-bottom: 2.5rem;
  }

  .category-section h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(247, 147, 26, 0.2);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-icon {
    height: 2rem;
    width: 2rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .initiatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.85rem;
  }

  .initiative-card {
    position: relative;
    border: 1px solid rgba(247, 147, 26, 0.15);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
    background: rgba(255, 255, 255, 0.12);
    transition:
      border-color 0.3s ease,
      transform 0.2s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .initiative-card:hover {
    border-color: rgba(247, 147, 26, 0.45);
    transform: translateY(-2px);
    background: rgba(247, 147, 26, 0.08);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .initiative-card.upcoming {
    border-style: dashed;
    opacity: 0.75;
  }

  .card-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    margin-bottom: 0.25rem;
  }

  .card-logo img {
    max-height: 48px;
    max-width: 100%;
    object-fit: contain;
  }

  .card-name {
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    transition: color 0.2s ease;
  }

  a.card-name:hover {
    color: var(--primary);
  }

  /* Stretch the link across the whole card — cards without a link (span) stay passive */
  a.card-name::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }

  .card-info {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(204, 204, 204, 0.7);
    margin: 0;
    flex-grow: 1;
  }

  .card-support {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(247, 147, 26, 0.08);
  }

  .support-label {
    font-size: 0.9rem;
  }

  .card-support code {
    font-size: 0.73rem;
    color: rgba(247, 147, 26, 0.7);
    background: rgba(247, 147, 26, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    word-break: break-all;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0.25rem;
    border-radius: 4px;
    color: rgba(247, 147, 26, 0.55);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .copy-btn:hover {
    color: var(--primary);
    background: rgba(247, 147, 26, 0.12);
  }

  .copy-btn svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .copy-btn .icon-check {
    display: none;
  }

  .copy-btn.copied .icon-copy {
    display: none;
  }

  .copy-btn.copied .icon-check {
    display: block;
    color: #4ade80;
  }

  .upcoming-section .upcoming-note {
    font-size: 0.9rem;
    color: rgba(204, 204, 204, 0.7);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .upcoming-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(247, 147, 26, 0.8);
    background: rgba(247, 147, 26, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .resource-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .resource-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(247, 147, 26, 0.1);
    color: var(--primary) !important;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none !important;
    transition: background 0.2s ease;
  }

  .resource-link:hover {
    background: rgba(247, 147, 26, 0.2);
  }

  .cta-section {
    padding: 1.5rem;
    background: rgba(247, 147, 26, 0.06);
    border: 1px solid rgba(247, 147, 26, 0.2);
    border-radius: 12px;
    text-align: center;
  }

  .cta-link {
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary) !important;
    text-decoration: none !important;
    transition: opacity 0.2s ease;
  }

  .cta-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 567px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-image {
      display: none;
    }

    .initiatives-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Older browsers/insecure context: select the text so the user can copy manually
        const code = btn.parentElement?.querySelector("code");
        if (code) {
          const range = document.createRange();
          range.selectNodeContents(code);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        return;
      }
      btn.classList.add("copied");
      setTimeout(() => btn.classList.remove("copied"), 1500);
    });
  });
</script>
