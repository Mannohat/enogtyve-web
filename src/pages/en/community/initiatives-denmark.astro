    icon: "/images/icons/organisationer.png",
    items: [
      {
        name: "Dansk Bitcoin Politisk Initiativ",
        url: "https://dbpi.dk",
        info: "DBPI is an independent nonprofit think tank that promotes knowledge, analysis, and responsible regulation of bitcoin in Denmark. The vision is a Denmark at the forefront, where bitcoin is integrated as a stable and free monetary foundation in a global, digital economy.",
