---
import { Image } from 'astro:assets';
import ResourcePageLayout from "../../layouts/ResourcePageLayout.astro";

const tools = [
  {
    name: "LNBits.com",
    url: "https://lnbits.com/",
    desc: 'LNBits is a fantastic tool and could perhaps be described as a kind of "WordPress" for Lightning.',
  },
  {
    name: "Lightning Piggy",
    url: "https://www.lightningpiggy.com",
    desc: "A project where you can build a Lightning piggy bank. Maybe pocket money should be swapped for pocket sats?",
  },
  {
    name: "Getumbrel.com",
    url: "https://www.getumbrel.com",
    desc: "Umbrel is an easy — if not the easiest — way to get started with your own Bitcoin node.",
  },
  {
    name: "Cryptocloaks.com",
    url: "https://www.cryptocloaks.com",
    desc: "They 3D-print all sorts of Bitcoin gear. Consider building an electric heater that mines satoshis at the same time.",
    extra: [
      { label: "21energy.io", url: "https://21energy.com/enogtyve" },
      { label: "Miningwholesale.eu", url: "https://miningwholesale.eu/" },
    ],
  },
  {
    name: "Nerdminer",
    url: "https://github.com/BitMaker-hub/NerdMiner_v2",
    desc: "Build your own little miner that can sit on your desk, for example. A perfect conversation starter — and who knows ;)",
  },
];

const projects = [
  {
    image: "/images/buidl/lnbits-pos-workshop.jpeg",
    caption: "LNBits POS workshop",
    url: "https://lnpos.lnbits.com/",
  },
  {
    image: "/images/buidl/lnbits-pos.jpeg",
    caption: "LNBits POS",
    url: "https://lnpos.lnbits.com/",
  },
  {
    image: "/images/buidl/diy-hardware-wallet.jpeg",
    caption: "DIY Hardware Wallet",
    url: "https://lnbits.github.io/hardware-wallet/installer/",
  },
  {
    image: "/images/buidl/zaplamp.png",
    caption: "Nostr ZAP Lamp",
    url: "https://nostr-zap-lamp.lnbits.com/",
  },
  {
    image: "/images/buidl/lightning-switch-mm.jpeg",
    caption: "LNBits Lightning switch m&m's",
    url: "https://lnbits.github.io/bitcoinswitch",
  },
  {
    image: "/images/buidl/lightning-switch-saebebubler.jpeg",
    caption: "LNBits Lightning switch bubble machine",
    url: "https://lnbits.github.io/bitcoinswitch",
  },
  {
    image: "/images/buidl/lightning-piggy.jpeg",
    caption: "Lightning Piggy",
    url: "https://www.lightningpiggy.com/",
  },
  {
    image: "/images/buidl/lnbits-pos-2.jpeg",
    caption: "LNBits POS",
    url: "https://lnpos.lnbits.com/",
  },
  {
    image: "/images/buidl/s9-spaceheater-adapter.jpeg",
    caption: "S9 spaceheater fan adapter print",
    url: "/en/mining/mining-for-heating",
  },
  {
    image: "/images/buidl/s9-spaceheater.jpeg",
    caption: "Bitmain S9 Spaceheater",
    url: "/en/mining/mining-for-heating",
  },
  {
    image: "/images/buidl/s9-spaceheater-brrr.jpeg",
    caption: "Bitmain S9 Spaceheater BRRR",
    url: "/en/mining/mining-for-heating",
  },
  {
    image: "/images/buidl/s9-nye-fans.jpeg",
    caption: "New cooling fans for the S9 space heater for less noise",
    url: "/en/mining/mining-for-heating",
  },
  {
    image: "/images/buidl/bitcoin-node.jpeg",
    caption: "Bitcoin Node",
    url: "https://www.getumbrel.com",
  },
  {
    image: "/images/buidl/lnbits-workshop.jpeg",
    caption: "LNBits workshop",
    url: "https://www.lightningpiggy.com",
  },
  {
    image: "/images/buidl/esp32-dot-display.jpeg",
    caption: "ESP32 BTC/USD dot display",
    url: "https://github.com/arcbtc/Hal-Finney-Price-Checker",
  },
  {
    image: "/images/buidl/btclock.jpg",
    caption: "The BTClock",
    url: "https://btclock.store/",
  },
];
---

<ResourcePageLayout
  title="BUIDL"
  description="Ideas and projects for those who want to build on Bitcoin in Denmark."
  lang="en"
>
  <section class="nav-buttons">
    <a href="/en/learn/lightning" class="nav-btn"
      >The Lightning Network</a
    >
    <a href="/en/learn/bitcoin-for-your-business" class="nav-btn"
      >Bitcoin and your business</a
    >
    <a href="/en/mining/mining-for-heating" class="nav-btn">Mining for heating</a>
  </section>

  <section class="content-section">
    <p>
      Once you've learned more about Bitcoin and maybe reached a point where you'd
      like to experiment a bit more, there are plenty of ways to play and learn.
      Bitcoin is fun — you can make all sorts of things! Maybe you have an idea for
      a project of your own?
    </p>
    <p>
      More and more tools keep appearing that make it easier to get started. As
      long as you make an effort to learn and experiment, there are plenty of
      people willing to help you.
    </p>
  </section>

  <section class="category-section">
    <h3 class="category-heading">
      <Image src="/images/icons/tools.png" alt="" width={1024} height={1024} class="cat-icon" /> Tools & resources
    </h3>
    <div class="tools-grid">
      {
        tools.map((tool) => (
          <div class="tool-card">
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="tool-name"
            >
              {tool.name}
            </a>
            <p class="tool-desc">{tool.desc}</p>
            {tool.extra && (
              <div class="tool-extra">
                {tool.extra.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tool-extra-link"
                  >
                    {link.label} →
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="category-section">
    <h3 class="category-heading">
      <Image src="/images/icons/camera.png" alt="" width={1024} height={1024} class="cat-icon" /> Photos of Bitcoin DIY projects
    </h3>
    <p class="gallery-note">
      Click an image to open a link where you can see how to get started with the
      project.
    </p>
    <div class="gallery-grid">
      {
        projects.map((proj) => (
          <a
            href={proj.url}
            target="_blank"
            rel="noopener noreferrer"
            class="gallery-item"
          >
            <div class="gallery-image">
              <img src={proj.image} alt={proj.caption} loading="lazy" />
            </div>
            <span class="gallery-caption">{proj.caption}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="category-section">
    <h3 class="category-heading">
      <Image src="/images/icons/video.png" alt="" width={1024} height={1024} class="cat-icon" /> Video
    </h3>
    <div class="video-container">
      <video controls preload="metadata">
        <source
          src="/images/buidl/lightning-switch-saebebubler.mov"
          type="video/mp4"
        />
      </video>
      <p class="video-caption">
        <a
          href="https://bitcoinswitch.lnbits.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Lightning switch bubble machine →
        </a>
      </p>
    </div>
  </section>
  <section class="quote-section">
    <div class="manifesto">
      <p class="manifesto-title">FUN is mandatory…</p>
      <p>We are all driven to be free.<br />
      To live life on our own terms.<br />
      But… we get trapped doing things we don't enjoy.<br />
      Working on things we don't believe in.<br />
      As the years go on, we just accept it.</p>
      <p>Creativity is hard to lock away.<br />
      It eats us away. We need to let it out.<br />
      Otherwise, it breaks us down.</p>
      <p>The journey is long and often lonely.<br />
      Excuses are easy.<br />
      We'll never know obstacles that will come.<br />
      We'll never know how to get it done.<br />
      We'll never know when's the right time.</p>
      <p>But <strong>MAKING</strong> something from passion, is <strong>FUN</strong>.<br />
      Make something together.<br />
      Have <strong>FUN</strong> pursuing the freedom.</p>
      <p class="manifesto-author">— Johns Beharry</p>
    </div>
  </section>
  <a href="#" class="back-to-top"> ↑ Back to top </a>
</ResourcePageLayout>

<style>
  .nav-buttons {
    display: flex;
    gap: var(--space-md, 1rem);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .nav-btn {
    flex: 1;
    min-width: 150px;
    text-align: center;
    padding: 0.75rem 1.5rem;
    background-color: #f7931a;
    color: #000;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid #f7931a;
    transition: all 0.3s ease;
  }

  .nav-btn:hover {
    background-color: transparent;
    color: #f7931a;
  }

  .content-section {
    margin-bottom: 2rem;
    line-height: 1.8;
    color: var(--text-light, #ccc);
  }

  .content-section p {
    margin-bottom: 0.75rem;
  }

  /* Category sections */
  .category-section {
    margin-bottom: 2.5rem;
  }

  .category-heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: #f7931a;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(247, 147, 26, 0.2);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-icon {
    height: 3rem;
    width: 3rem;
    object-fit: contain;
  }

  /* Tool cards */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.85rem;
  }

  .tool-card {
    border: 1px solid rgba(247, 147, 26, 0.12);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    transition:
      border-color 0.3s ease,
      transform 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .tool-card:hover {
    border-color: rgba(247, 147, 26, 0.4);
    transform: translateY(-2px);
  }

  .tool-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-light, #ccc);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tool-name:hover {
    color: #f7931a;
  }

  .tool-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(204, 204, 204, 0.7);
    margin: 0;
    flex-grow: 1;
  }

  .tool-extra {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(247, 147, 26, 0.08);
  }

  .tool-extra-link {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    background: rgba(247, 147, 26, 0.1);
    color: #f7931a;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: 5px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .tool-extra-link:hover {
    background: rgba(247, 147, 26, 0.2);
  }

  /* Gallery */
  .gallery-note {
    font-size: 0.9rem;
    color: rgba(204, 204, 204, 0.6);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0.85rem;
  }

  .gallery-item {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(247, 147, 26, 0.1);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      transform 0.2s ease;
  }

  .gallery-item:hover {
    border-color: rgba(247, 147, 26, 0.4);
    transform: translateY(-2px);
  }

  .gallery-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover .gallery-image img {
    transform: scale(1.05);
  }

  .gallery-caption {
    padding: 0.65rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(204, 204, 204, 0.8);
    line-height: 1.4;
  }

  /* Video */
  .video-container {
    max-width: 500px;
  }

  .video-container video {
    width: 100%;
    border-radius: 10px;
    border: 1px solid rgba(247, 147, 26, 0.12);
  }

  .video-caption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  .video-caption a {
    color: #f7931a;
    text-decoration: none;
    font-weight: 600;
  }

  .video-caption a:hover {
    opacity: 0.8;
  }

  /* Manifesto quote */
  .quote-section {
    margin-bottom: 2rem;
  }

  .manifesto {
    margin: 0;
    padding: 2.5rem 3rem;
    border-radius: 12px;
    background: rgba(247, 147, 26, 0.04);
    border: 1px solid rgba(247, 147, 26, 0.15);
    border-top: 3px solid #f7931a;
    text-align: center;
  }

  .manifesto-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f7931a;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .manifesto p {
    font-size: 0.92rem;
    line-height: 2;
    color: rgba(204, 204, 204, 0.8);
    margin-bottom: 1.25rem;
    font-style: italic;
  }

  .manifesto strong {
    color: #f7931a;
    font-style: normal;
    font-weight: 700;
  }

  .manifesto-author {
    font-size: 0.9rem;
    color: #f7931a;
    font-weight: 600;
    font-style: normal !important;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  @media (max-width: 567px) {
    .manifesto {
      padding: 1.5rem 1.25rem;
    }
  }

  @media (max-width: 567px) {
    .nav-buttons {
      flex-direction: column;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
  }
</style>
