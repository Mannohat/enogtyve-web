                logo: "/images/logos/gobrrr.svg",
            },
            {
                name: "Bitronics",
                url: "https://bitronics.store/?ref=1089",
                desc: "Bitcoin electronics and gadgets",
                logo: "/images/logos/bitronics.svg",
            },
            {
                name: "Tinyseed",
                url: "https://tinyseed.io/enogtyve",
                desc: "Compact steel seed phrase backup",
                logo: "/images/logos/tinyseed.png",
            },
            {
                name: "Pleb Style",
                url: "https://pleb.style/",
                desc: "DIY Bitcoin gadgets and kits",
                logo: "/images/logos/plebstyle.webp",
            },
            {
                name: "Shop.LNBits.com",
                url: "https://shop.lnbits.com/",
                desc: "LNBits hardware shop",
            },
            {
                name: "Solosatoshi.com",
                url: "https://www.solosatoshi.com/",
                desc: "Solo mining hardware",
            },
            {
                name: "D-Central",
                url: "https://d-central.tech/",
                desc: "Mining and Bitcoin tech",
            },
            {
                name: "Thesolomining.co",
                url: "https://www.thesolomining.co/",
                desc: "Solo mining equipment",
            },
            {
                name: "Bitcoinbrabant.com",
                url: "https://bitcoinbrabant.com/",
                desc: "Bitcoin hardware from the Netherlands",
            },
            {
                name: "BTClock.store",
                url: "https://btclock.store/",
                desc: "Bitcoin clocks and displays",
            },
        ],
    },
    {
        title: "Merchandise",
        links: [
            {
                name: "Store of Value",
                url: "https://www.storeofvalue.eu/discount/enogtyve",
                desc: "Bitcoin clothing and merch",
                logo: "/images/logos/storeofvalue.png",
            },
            {
                name: "Shop21.dk",
                url: "https://shop21.dk/",
                desc: "Danish Bitcoin merchandise",
                logo: "/images/logos/shop21.png",
            },
            {
                name: "Free Madeira shop",
                url: "https://shop.freemadeira.org/discount/enogtyve",
                desc: "Bitcoin merch from Madeira",
                logo: "/images/logos/freemadeira.webp",
            },
            {
                name: "Satoshistore.io",
                url: "https://www.satoshistore.io",
                desc: "Bitcoin merchandise",
            },
            {
                name: "Cryptocloaks.com",
                url: "https://www.cryptocloaks.com",
                desc: "3D-printed Bitcoin products",
            },
            {
                name: "Bitcoinstickers.co.uk",
                url: "https://www.bitcoinstickers.co.uk",
                desc: "Bitcoin stickers",
            },
        ],
    },
    {
        title: "Travel & Experiences",
        links: [
            {
                name: "Airbtc.online",
