---
import ResourcePageLayout from "../../../layouts/ResourcePageLayout.astro";
import { localizedHref } from "../../../i18n/routes";

const categories = [
    {
        title: "Hardware Wallets",
        links: [
            {
                name: "Recommendations",
                url: "/en/get-started/hardware-wallets",
                desc: "See our hardware wallet recommendations",
                external: false,
            },
        ],
    },
    {
        title: "Miners / ASICs",
        links: [
            {
                name: "21energy",
                url: "https://21energy.com/enogtyve",
                desc: "Bitcoin heating products",
                logo: "/images/logos/21energy.png",
            },
            {
                name: "Heatbit",
                url: "https://heatbit.com/?ref=ENOGTYVE",
                desc: "Bitcoin heating solutions for the home",
                logo: "/images/logos/heatbit_w.svg",
            },
            {
                name: "Miningwholesale.eu",
                url: "https://miningwholesale.eu/",
                desc: "European reseller of mining equipment",
            },
        ],
    },
    {
        title: "Mining Pools",
        links: [
            {
                name: "Braiins",
                url: "https://braiins.com/",
                desc: "Open-source mining pool and firmware",
            },
        ],
    },
    {
        title: "Hosted Mining",
        links: [
            {
                name: "Munich International Mining (MIM)",
                url: "https://www.mim.farm",
                desc: "Hosted mining service",
            },
        ],
    },
    {
        title: "Gizmos, Signers & Gadgets",
        links: [
            {
                name: "Coinkite",
                url: "https://store.coinkite.com/promo/F5E096EEF1AEDDAC4255",
                desc: "COLDCARD and Bitcoin security products",
                logo: "/images/logos/coinkite.png",
            },
            {
                name: "GoBrrr",
                url: "https://www.gobrrr.me/?coupon=enogtyve",
