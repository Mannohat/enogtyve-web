---

<ResourcePageLayout
    title="Bitcoin Products and Services"
    description="An overview of Bitcoin products and services you can use today."
    lang="en"
>
    <section class="intro">
        <p>
            Below you'll find a collection of Bitcoin-related products and
            services — from hardware wallets and miners to merchandise and travel.
        </p>
        <p class="highlight">
            Remember that in many places you get a small discount with the code "enogtyve". See the overview of discounts here: <a href={localizedHref('/da/rabat', 'en')}><strong>discounts here</strong></a>.
        </p>
    </section>

    {
        categories.map((cat) => (
            <section class="category-section">
                <h2>{cat.title}</h2>
                <div class="links-grid">
                    {cat.links.map((link) => (
                        <a
                            href={link.url}
                            target={link.external === false ? undefined : "_blank"}
                            rel={link.external === false ? undefined : "noopener noreferrer"}
                            class="link-card"
                        >
                            {link.logo && (
                                <img src={link.logo} alt="" class="link-logo" />
                            )}
                            <div class="link-content">
                                <span class="link-name">{link.name}</span>
                                <span class="link-desc">{link.desc}</span>
                            </div>
                            <span class="link-arrow">→</span>
                        </a>
                    ))}
                </div>
            </section>
        ))
    }

    <section class="overview-note">
        <p>
            See a comprehensive overview of businesses that accept Bitcoin:
            <a href="https://www.bitlist.com/" target="_blank" rel="noopener noreferrer">
                <strong>Bitlist.com →</strong>
            </a>
        </p>
    </section>

    <a href="#" class="back-to-top"> ↑ Back to top </a>
</ResourcePageLayout>

<style>
    .intro {
        margin-bottom: 2.5rem;
        line-height: 1.8;
        color: var(--text-light, #ccc);
    }

    .intro p {
        margin-bottom: 0.75rem;
    }

    .highlight {
        padding: 0.75rem 1rem;
        background: rgba(247, 147, 26, 0.06);
        border-left: 3px solid var(--primary);
        border-radius: 0 8px 8px 0;
    }

    /* Category sections */
    .category-section {
        margin-bottom: 2.5rem;
    }

    .category-section h2 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(247, 147, 26, 0.2);
    }

    /* Links grid */
    .links-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 0.75rem;
    }

    .link-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        min-height: 68px;
        border: 1px solid rgba(247, 147, 26, 0.12);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        transition:
            border-color 0.3s ease,
            transform 0.2s ease;
    }

    .link-card:hover {
        border-color: rgba(247, 147, 26, 0.4);
        transform: translateY(-2px);
    }

    .link-logo {
        height: 40px;
        width: auto;
        min-width: 40px;
        max-width: 80px;
        object-fit: contain;
        flex-shrink: 0;
        border-radius: 4px;
    }

    .link-content {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        flex: 1;
        min-width: 0;
    }

    .link-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-light, #ccc);
    }

    .link-desc {
        font-size: 0.8rem;
        line-height: 1.4;
        color: rgba(204, 204, 204, 0.5);
    }

    .link-arrow {
        color: var(--primary);
        font-size: 0.9rem;
        opacity: 0.3;
        flex-shrink: 0;
        transition: opacity 0.2s ease;
    }

    .link-card:hover .link-arrow {
        opacity: 1;
    }

    /* Overview note */
    .overview-note {
        margin-top: 1rem;
        padding: 1rem 1.25rem;
        background: rgba(247, 147, 26, 0.04);
        border: 1px solid rgba(247, 147, 26, 0.12);
        border-radius: 10px;
        text-align: center;
        line-height: 1.7;
        color: var(--text-light, #ccc);
    }

    .overview-note p {
        margin: 0;
    }

    @media (max-width: 567px) {
        .links-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
