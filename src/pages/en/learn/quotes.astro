---
import ResourcePageLayout from "../../../layouts/ResourcePageLayout.astro";

const mantras = [
  "Bitcoin is gold for nerds.",
  "In Bitcoin we trust.",
  "Be your own bank.",
  "HODL.",
  "Not your keys, not your coins.",
  "There are 100,000,000 sats in a bitcoin.",
  "Bitcoin was predicted by Henry Ford, Friedrich Hayek, and Milton Friedman.",
  "Do your own research.",
  "Think for yourself.",
  "Don't let others think for you.",
  "Always seek the truth, always.",
  "Bitcoin is right.",
  "Cypherpunks write code.",
];

const lifeWisdom = [
  "Love yourself and love others.",
  "Be just, be fair, and be kind.",
  "If you're afraid of something, look into it.",
  "Everyone has a hungry heart.",
  "All people want the same basic things for the same reasons.",
  "No matter how much you have, you'll be just as happy.",
  "Having more won't make you happy.",
  "Practice compassion — put yourself in others' shoes.",
  "Practice mindfulness — feel without judgment.",
  "Experience with curiosity.",
  "Practice gratitude — always find things to be grateful for.",
  "Actions speak louder than words.",
  "What you do determines who you are.",
  "You have a right to property.",
  "Your body is your property.",
  "You are the only one who decides over yourself.",
  "Your life is yours and yours alone. Only you can live your life.",
];

const quotes = [
  { text: "If you don't believe me or don't get it, I don't have time to try to convince you, sorry.", author: "Satoshi Nakamoto" },
  { text: "The heat from your computer is not wasted if you need to heat your home.", author: "Satoshi Nakamoto" },
  { text: "What does everyone think about the ₿ symbol with the two lines going through the outside?", author: "Satoshi Nakamoto" },
  { text: "The credential that establishes someone as real is the ability to supply CPU power.", author: "Satoshi Nakamoto" },
  { text: "For greater privacy, it's best to use Bitcoin addresses only once.", author: "Satoshi Nakamoto" },
  { text: "I'm sure that in 20 years there will either be very large transaction volume or no volume.", author: "Satoshi Nakamoto" },
  { text: "Lost coins only make everyone else's coins worth slightly more. Think of it as a donation to everyone.", author: "Satoshi Nakamoto" },
  { text: "Stay humble, stack sats.", author: "Matt Odell" },
  { text: "Bitcoin is a strange game where the only winning move is to play.", author: "Bitstein" },
  { text: "If privacy is outlawed, only outlaws will have privacy.", author: "Phil Zimmermann" },
];
---

<ResourcePageLayout
  title="Quotes"
  description="The best Bitcoin quotes — for inspiration and orange-pilling."
  lang="en"
>
  <section class="category-section">
    <h2>₿ Bitcoin mantras</h2>
    <div class="mantras-grid">
      {mantras.map((m) => (
        <div class="mantra-card">
          <p>{m}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="category-section">
    <h2>Life wisdom</h2>
    <div class="mantras-grid">
      {lifeWisdom.map((m) => (
        <div class="mantra-card wisdom">
          <p>{m}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="category-section">
    <h2>Quotes</h2>
    <div class="quotes-list">
      {quotes.map((q) => (
        <blockquote class="quote-card">
          <p class="quote-text">"{q.text}"</p>
          <footer class="quote-author">— {q.author}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <a href="#" class="back-to-top"> ↑ Back to top </a>
</ResourcePageLayout>

<style>
  /* Category sections */
  .category-section {
    margin-bottom: 3rem;
  }

  .category-section h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(247, 147, 26, 0.2);
  }

  /* Mantra cards */
  .mantras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .mantra-card {
    border: 1px solid rgba(247, 147, 26, 0.12);
    border-radius: 10px;
    padding: 1rem 1.15rem;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s ease, transform 0.2s ease;
  }

  .mantra-card:hover {
    border-color: rgba(247, 147, 26, 0.4);
    transform: translateY(-2px);
  }

  .mantra-card p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--text-light, #ccc);
    font-weight: 500;
  }

  .mantra-card.wisdom {
    border-color: rgba(247, 147, 26, 0.08);
  }

  .mantra-card.wisdom p {
    font-weight: 400;
  }

  /* Quote cards */
  .quotes-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quote-card {
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(247, 147, 26, 0.12);
    border-left: 3px solid var(--primary);
    border-radius: 0 10px 10px 0;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.3s ease;
  }

  .quote-card:hover {
    border-color: rgba(247, 147, 26, 0.35);
    border-left-color: var(--primary);
  }

  .quote-text {
    margin: 0 0 0.6rem 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-light, #ccc);
    font-style: italic;
  }

  .quote-author {
    font-size: 0.82rem;
    color: var(--primary);
    font-weight: 600;
    font-style: normal;
  }

  @media (max-width: 567px) {
    .mantras-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
