---
interface Props { lang: "da" | "en" }
const { lang } = Astro.props;

const t = lang === "da" ? {
  title: "WiFi QR-brikkebræt",
  lead: "Indtast netværkets navn og kode, og skemaet viser hvilken brik der skal ligge i hvert felt på brættet. Hjørneblokkene er støbt ind i brættet. Det afskårne hjørne på hver brik vender mod bogstaverne.",
  ssid: "Netværksnavn (SSID)", pass: "Kode", sec: "Sikkerhed", open: "Åbent netværk", hidden: "Skjult netværk",
  make: "Lav skema", scan: "Sådan skal den scanne", tiles: "Brikker der skal bruges", rows: "Række for række", print: "Udskriv skema",
  invnote: "177 brikker i alt. Sættet har 24 af hver.",
  used: "af 53 bytes brugt",
  toolong: "For langt til brættet: {n} bytes, koden kan rumme 53. Forkort netværksnavnet eller koden.",
  chosen: "Maske <b>{m}</b>, fejlkorrektion <b>{e}</b> — valgt fordi den kræver færrest brikker af én type (højst <b>{w}</b> af 24).",
  over: "Denne kode kræver {n} brik(ker) mere end sættet indeholder.",
  fixed: "støbt ind i brættet", tile: "brik",
  dlTitle: "3D-print filer", dlLead: "Brættet og brikkerne printes i to farver (lys og mørk PLA). Filerne er klar til Bambu Studio med begge dele tildelt hver sit filament. Start med testsættet på 16 brikker og tjek pasformen, før du printer det fulde sæt.",
  dlAll: "Hent alle filer (zip)", dlBoard: "Bræt", dlTest: "Testsæt, 16 brikker", dlFull: "Fuldt sæt, 384 brikker", dlAllOne: "Alt på én plade (A2L)", dlSrc: "OpenSCAD-kilder", dlReadme: "Vejledning",
} : {
  title: "WiFi QR tile board",
  lead: "Enter the network name and password and the chart shows which tile goes in every slot of the board. The corner blocks are moulded into the board. The clipped corner of every tile points at the letters.",
  ssid: "Network name (SSID)", pass: "Password", sec: "Security", open: "Open network", hidden: "Hidden network",
  make: "Make chart", scan: "What it should scan as", tiles: "Tiles needed", rows: "Row by row", print: "Print chart",
  invnote: "177 tiles in total. The set has 24 of each.",
  used: "of 53 bytes used",
  toolong: "Too long for the board: {n} bytes, the code holds 53. Shorten the network name or password.",
  chosen: "Mask <b>{m}</b>, error correction <b>{e}</b> — chosen because it needs the fewest tiles of any one type (max <b>{w}</b> of 24).",
  over: "This code needs {n} more tile(s) than the set contains.",
  fixed: "built into the board", tile: "tile",
  dlTitle: "3D print files", dlLead: "The board and tiles print in two colours (light and dark PLA). The files are ready for Bambu Studio with both parts assigned to their own filament. Start with the 16-tile test set and check the fit before printing the full set.",
  dlAll: "Download all files (zip)", dlBoard: "Board", dlTest: "Test set, 16 tiles", dlFull: "Full set, 384 tiles", dlAllOne: "Everything on one plate (A2L)", dlSrc: "OpenSCAD sources", dlReadme: "Instructions",
};

const base = "/downloads/wifi-qr-board/";
const files = [
  { label: t.dlAllOne, href: base + "qr_puzzle_board_all.3mf", size: "2.0 MB" },
  { label: t.dlBoard, href: base + "qr_board.3mf", size: "88 kB" },
  { label: t.dlTest, href: base + "qr_tiles_one_of_each.3mf", size: "87 kB" },
  { label: t.dlFull, href: base + "qr_tiles_full_set_384.3mf", size: "1.9 MB" },
  { label: t.dlSrc, href: base + "board.scad", size: "board.scad" },
  { label: t.dlSrc, href: base + "tile.scad", size: "tile.scad" },
  { label: t.dlReadme, href: base + "README.md", size: "README.md" },
];
---

<section class="wqb">

  <form id="wqb-form">
    <div><label for="wqb-ssid">{t.ssid}</label><input id="wqb-ssid" type="text" autocomplete="off" required /></div>
    <div><label for="wqb-pass">{t.pass}</label><input id="wqb-pass" type="text" autocomplete="off" /></div>
    <div><label for="wqb-sec">{t.sec}</label>
      <select id="wqb-sec"><option value="WPA">WPA / WPA2 / WPA3</option><option value="WEP">WEP</option><option value="nopass">{t.open}</option></select></div>
    <div><button type="submit">{t.make}</button></div>
    <div class="hidden-row"><label><input id="wqb-hidden" type="checkbox" />{t.hidden}</label><span id="wqb-len"></span></div>
  </form>
  <p class="status" id="wqb-status"></p>

  <div class="result" id="wqb-result" hidden>
    <div class="board" id="wqb-board"></div>
    <div class="side">
      <h2 class="section-title">{t.scan}</h2>
      <canvas id="wqb-qr" width="300" height="300" aria-label="QR"></canvas>
      <h2 class="section-title">{t.tiles}</h2>
      <p>{t.invnote}</p>
      <div class="inv" id="wqb-inv"></div>
      <h2 class="section-title">{t.rows}</h2>
      <div class="rows" id="wqb-rows"></div>
      <button type="button" class="printbtn" id="wqb-print">{t.print}</button>
    </div>
  </div>

  <div class="downloads">
    <h2 class="section-title">{t.dlTitle}</h2>
    <p class="lead">{t.dlLead}</p>
    <a class="dl-all" href={base + "wifi-qr-board-print-files.zip"} download>{t.dlAll}</a>
    <ul class="dl-list">
      {files.map(f => <li><a href={f.href} download>{f.label}</a><span>{f.size}</span></li>)}
    </ul>
  </div>
</section>

<script type="application/json" id="wqb-i18n" set:html={JSON.stringify({ used: t.used, toolong: t.toolong, chosen: t.chosen, over: t.over, fixed: t.fixed, tile: t.tile })} />

<script>
  import { plan, wifiString, FIXED, HEX, INVENTORY, type Security } from "../../lib/wifi-qr-chart";

  const $ = (id: string) => document.getElementById(id)!;
  const i18n = JSON.parse($("wqb-i18n").textContent || "{}");
  const fmt = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));

  const inputs = () => ({
    ssid: ($("wqb-ssid") as HTMLInputElement).value,
    pass: ($("wqb-pass") as HTMLInputElement).value,
    sec: ($("wqb-sec") as HTMLSelectElement).value as Security,
    hidden: ($("wqb-hidden") as HTMLInputElement).checked,
  });

  function showLength() {
    const { ssid, pass, sec, hidden } = inputs();
    const n = new TextEncoder().encode(wifiString(ssid, pass, sec, hidden)).length;
    $("wqb-len").textContent = `${n} ${i18n.used}`;
  }

  function update() {
    const { ssid, pass, sec, hidden } = inputs();
    if (!ssid) return;
    const text = wifiString(ssid, pass, sec, hidden);
    const bytes = new TextEncoder().encode(text).length;
    const st = $("wqb-status");
    const p = plan(text, INVENTORY);
    if (!p) { st.className = "status err"; st.textContent = fmt(i18n.toolong, { n: bytes }); $("wqb-result").hidden = true; return; }
    st.className = "status";
    st.innerHTML = fmt(i18n.chosen, { m: p.mask, e: p.ecl, w: p.worst }) +
      (p.over ? ` <span class="over">${fmt(i18n.over, { n: p.over })}</span>` : "");
    render(p); $("wqb-result").hidden = false;
  }

  function render(p: NonNullable<ReturnType<typeof plan>>) {
    const letters = "<tr><th></th>" + Array.from({ length: 15 }, (_, c) => `<th class="col">${String.fromCharCode(65 + c)}</th>`).join("") + "<th></th></tr>";
    let h = "<table>" + letters;
    for (let r = 0; r < 15; r++) {
      h += `<tr><th class="row">${r + 1}</th>`;
      for (let c = 0; c < 15; c++) {
        const id = p.ids[r][c], g = p.grid, fx = FIXED(r, c);
        const q = [g[2*r][2*c], g[2*r][2*c+1], g[2*r+1][2*c], g[2*r+1][2*c+1]];
        const coord = String.fromCharCode(65 + c) + (r + 1);
        h += `<td class="cell${fx ? " fx" : ""}" title="${coord} ${fx ? `(${i18n.fixed})` : `: ${i18n.tile} ${HEX[id]}`}">`;
        h += `<span class="pat">${q.map(d => `<i class="${d ? "d" : ""}"></i>`).join("")}</span>`;
        if (!fx) h += `<span class="clip"></span><span class="id">${HEX[id]}</span>`;
        h += "</td>";
      }
      h += `<th class="row">${r + 1}</th></tr>`;
    }
    $("wqb-board").innerHTML = h + letters + "</table>";
    $("wqb-inv").innerHTML = p.counts.map((n, i) => `<div class="${n > INVENTORY ? "over" : n === 0 ? "zero" : ""}">${HEX[i]} × ${n}</div>`).join("");
    $("wqb-rows").textContent = p.ids.map((row, r) => String(r + 1).padStart(2) + "  " + row.map((v, c) => FIXED(r, c) ? "·" : HEX[v]).join(" ")).join("\n");
    const cv = $("wqb-qr") as HTMLCanvasElement, ctx = cv.getContext("2d"), s = 300 / 38;
    if (!ctx) return;
    ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, 300, 300); ctx.fillStyle = "#000";
    for (let r = 0; r < 30; r++) for (let c = 0; c < 30; c++)
      if (p.grid[r][c]) ctx.fillRect(Math.round((c + 4) * s), Math.round((r + 4) * s), Math.ceil(s), Math.ceil(s));
  }

  $("wqb-form").addEventListener("submit", e => { e.preventDefault(); update(); });
  ["wqb-ssid", "wqb-pass", "wqb-sec", "wqb-hidden"].forEach(id => $(id).addEventListener("input", showLength));
  $("wqb-sec").addEventListener("change", () => { ($("wqb-pass") as HTMLInputElement).disabled = ($("wqb-sec") as HTMLSelectElement).value === "nopass"; });
  $("wqb-print").addEventListener("click", () => window.print());
</script>

<style>
  .wqb { padding-bottom: var(--space-lg); }
  .wqb .lead { color: var(--text-light); max-width: 62ch; margin-bottom: 1.5rem; }
  .wqb form { display: grid; grid-template-columns: 1.2fr 1.2fr .8fr auto; gap: 1rem; align-items: end; background: var(--background-card); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; }
  .wqb label { display: block; font-size: .85rem; color: var(--text-light); margin-bottom: .3rem; }
  .wqb input[type=text], .wqb select { width: 100%; font: inherit; padding: .6rem .75rem; border: 2px solid var(--border); border-radius: 4px; background: var(--background); color: var(--text); transition: border-color .2s ease; }
  .wqb input[type=text]:focus, .wqb select:focus { outline: none; border-color: var(--primary); }
  .wqb input:disabled { opacity: .4; }
  .wqb button { font: inherit; font-weight: 600; padding: .7rem 1.4rem; border: 0; border-radius: 4px; background: var(--primary); color: #000; cursor: pointer; transition: background .2s ease; }
  .wqb button:hover { background: var(--primary-dark); }
  .wqb .hidden-row { grid-column: 1 / -1; display: flex; gap: 1.25rem; align-items: center; font-size: .85rem; color: var(--text-light); }
  .wqb .hidden-row label { display: inline; margin: 0; }
  .wqb .hidden-row input { margin-right: .4rem; accent-color: var(--primary); }
  .wqb .status { margin: 1rem 0 0; min-height: 1.6rem; font-size: .95rem; }
  .wqb .status :global(b) { color: var(--primary); }
  .wqb .status.err { color: var(--primary); }
  .wqb .status :global(.over) { color: #ff6b6b; }
  .wqb .result { display: grid; grid-template-columns: 1fr 260px; gap: 1.5rem; margin-top: 1.5rem; align-items: start; }
  @media (max-width: 820px) { .wqb form { grid-template-columns: 1fr 1fr; } .wqb .result { grid-template-columns: 1fr; } }

  /* the board stays light: it depicts the white board */
  .wqb .board { background: #f1efe8; border: 1px solid var(--border); border-radius: 8px; padding: 10px; display: inline-block; color: #1c1b19; max-width: 100%; overflow-x: auto; }
  .wqb .board :global(table) { border-collapse: separate; border-spacing: 3px; }
  .wqb .board :global(th) { display: table-cell; font-family: var(--font-mono); font-size: 14px; font-weight: 600; line-height: 1; color: #1c1b19; padding: 0; text-align: center; vertical-align: middle; background: transparent; }
  .wqb .board :global(th.col) { height: 22px; min-width: 42px; }
  .wqb .board :global(th.row) { width: 26px; }
  .wqb .board :global(.cell) { width: 42px; height: 42px; background: #fbfaf6; border-radius: 3px; position: relative; padding: 0; vertical-align: top; box-shadow: 0 0 0 1px rgba(0,0,0,.08) inset; }
  .wqb .board :global(.cell .pat) { position: absolute; left: 5px; top: 5px; width: 20px; height: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; }
  .wqb .board :global(.cell .pat i) { display: block; background: #fff; border: 1px solid #d6d2c6; }
  .wqb .board :global(.cell .pat i.d) { background: #1e1e1e; border-color: #1e1e1e; }
  .wqb .board :global(.cell .id) { position: absolute; right: 5px; bottom: 2px; font-family: var(--font-mono); font-weight: 700; font-size: 15px; line-height: 1; }
  .wqb .board :global(.cell.fx) { background: #dcd8cd; box-shadow: none; }
  .wqb .board :global(.cell.fx .pat) { width: 32px; height: 32px; }
  .wqb .board :global(.cell.fx .pat i) { border-color: transparent; background: #f1efe8; }
  .wqb .board :global(.cell.fx .pat i.d) { background: #1e1e1e; }
  .wqb .board :global(.cell .clip) { position: absolute; left: 0; top: 0; width: 0; height: 0; border-top: 7px solid #f1efe8; border-right: 7px solid transparent; }

  .wqb .side p { font-size: .85rem; color: var(--text-light); margin-bottom: .75rem; }
  .wqb .inv { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; margin-bottom: 1.5rem; }
  .wqb .inv :global(div) { background: var(--background-card); border: 1px solid var(--border); border-radius: 4px; padding: .4rem; text-align: center; font-family: var(--font-mono); font-size: .85rem; }
  .wqb .inv :global(div.over) { border-color: #ff6b6b; color: #ff6b6b; }
  .wqb .inv :global(div.zero) { opacity: .4; }
  .wqb canvas { display: block; image-rendering: pixelated; border: 1px solid var(--border); border-radius: 4px; background: #fff; margin-bottom: 1.5rem; }
  .wqb .rows { font-family: var(--font-mono); font-size: .85rem; white-space: pre; line-height: 1.7; background: var(--background-card); border: 1px solid var(--border); border-radius: 4px; padding: .75rem; overflow-x: auto; margin-bottom: 1rem; }
  .wqb .printbtn { background: transparent; color: var(--primary); border: 1px solid var(--border); }
  .wqb .printbtn:hover { background: rgba(247,147,26,.1); }

  .wqb .downloads { margin-top: var(--space-lg); }
  .wqb .dl-all { display: inline-block; font-weight: 600; padding: .7rem 1.4rem; border-radius: 4px; background: var(--primary); color: #000; margin-bottom: 1rem; }
  .wqb .dl-all:hover { background: var(--primary-dark); color: #000; }
  .wqb .dl-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .5rem; }
  .wqb .dl-list li { display: flex; justify-content: space-between; gap: 1rem; background: var(--background-card); border: 1px solid var(--border); border-radius: 4px; padding: .6rem .8rem; }
  .wqb .dl-list span { color: var(--text-light); font-size: .85rem; font-family: var(--font-mono); white-space: nowrap; }

  @media print {
    .wqb form, .wqb .lead, .wqb .printbtn, .wqb canvas, .wqb .downloads { display: none; }
    .wqb .result { grid-template-columns: 1fr; }
    .wqb .rows, .wqb .inv :global(div) { background: #fff; color: #000; border-color: #999; }
  }
</style>
