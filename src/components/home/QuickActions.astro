---
import { Image } from 'astro:assets';
import { conferences } from "../../data/events";

interface Props {
	lang: "da" | "en";
}
const { lang } = Astro.props;
const isEn = lang === "en";
const contentLang = isEn ? "da" : lang;

// Promote the next upcoming conference (soonest first); banner hides if none.
const today = new Date();
today.setHours(0, 0, 0, 0);
const nextConference = conferences
	.filter((c) => new Date(c.endISO) >= today)
	.sort((a, b) => a.startISO.localeCompare(b.startISO))[0];
// timeLocation is "DATE · LOCATION" — the banner shows just the date part.
const nextConfDate = nextConference
	? (isEn ? nextConference.timeLocation.en : nextConference.timeLocation.da).split(" · ")[0]
	: "";
const nextConfDiscount = nextConference?.discount
	? (isEn ? nextConference.discount.en : nextConference.discount.da)
	: undefined;

const logos = [
	{
		href: isEn ? "https://mempool.space" : "https://mempool.space/da",
		logo: "/images/logos/mempool.png",
		alt: isEn
			? "Mempool.space — Bitcoin block explorer"
			: "Mempool.space - Bitcoin block explorer",
		width: 224,
		height: 56,
	},
	{
		href: "https://timechaincalendar.com",
		logo: "/images/logos/timechaincal.png",
		alt: isEn
			? "Timechain Calendar — Bitcoin halving calendar"
			: "Timechain Calendar - Bitcoin halving kalender",
		width: 56,
		height: 56,
	},
	{
		href: "https://bitcoin.clarkmoody.com/dashboard/",
		logo: "/images/logos/clarkmoody.png",
		alt: "Clark Moody Bitcoin Dashboard",
		width: 56,
		height: 56,
	},
	{
		href: "https://amboss.space",
		logo: "/images/logos/amboss.png",
		alt: "Amboss - Lightning Network explorer",
		width: 422,
		height: 56,
	},
	{
		href: "https://nakamotoinstitute.org",
		logo: "/images/logos/nakamotoinstitute.png",
		alt: isEn
			? "Nakamoto Institute — Bitcoin literature and resources"
			: "Nakamoto Institute - Bitcoin litteratur og ressourcer",
		width: 144,
		height: 56,
	},
	{
		href: "https://bitbo.io",
		logo: "/images/logos/bitbo.png",
		alt: "Bitbo - Bitcoin dashboard",
		width: 232,
		height: 56,
	},
];

const actions = [
	{
		icon: "/images/icons/bookmark.png",
		label: isEn ? "Bookmarks" : "Bogmærker",
		href: `/${contentLang}/faellesskab/bookmarks`,
	},
	{
		icon: "/images/icons/podcasts.png",
		label: "Podcasts",
		href: `/${contentLang}/podcasts`,
	},
	{
		icon: "/images/icons/promo.png",
		label: isEn ? "Discounts" : "Rabat",
		href: `/${contentLang}/rabat`,
	},
	{
		icon: "/images/icons/blockchain.png",
		label: isEn ? "Blockchain" : "Blokkæden",
		href: `/${contentLang}/laer-mere/bitcoin-blockchain`,
	},
];
---

<section class="quick-actions">
	<div class="container">
		<div class="logo-cards">
			{
				logos.map((item) => (
					<a
						href={item.href}
						class="logo-card"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Image src={item.logo} alt={item.alt} width={item.width} height={item.height} class="logo-img" />
					</a>
				))
			}
		</div>

		<div class="action-cards">
			{
				actions.map((action) =>
					action.external ? (
						<a
							href={action.href}
							class="action-card"
							target="_blank"
							rel="noopener noreferrer"
						>
							{action.icon.startsWith("/") ? (
								<Image
									src={action.icon}
									alt={action.label}
									width={112}
									height={112}
									class="card-icon-img"
								/>
							) : (
								<span class="card-icon">{action.icon}</span>
							)}
							<span class="card-label">{action.label}</span>
						</a>
					) : (
						<a href={action.href} class="action-card">
							{action.icon.startsWith("/") ? (
								<Image
									src={action.icon}
									alt={action.label}
									width={112}
									height={112}
									class="card-icon-img"
								/>
							) : (
								<span class="card-icon">{action.icon}</span>
							)}
							<span class="card-label">{action.label}</span>
						</a>
					),
				)
			}
		</div>

		{nextConference && (
			<div class="event-banner">
				<a
					href={nextConference.url}
					class="event-main"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						src={nextConference.image}
						alt={nextConference.name}
						class="event-logo"
					/>
					<div class="event-info">
						<span class="event-name">{nextConference.name}</span>
						<span class="event-date">{nextConfDate}</span>
						{nextConfDiscount && (
							<span class="event-discount">{nextConfDiscount}</span>
						)}
					</div>
				</a>
				<a href={`/${contentLang}/udforsk/konferencer`} class="event-more">
					{isEn ? "More conferences →" : "Se flere konferencer →"}
				</a>
			</div>
		)}
	</div>
</section>

<style>
	.quick-actions {
		padding: 1.5rem 0 1rem;
		border-bottom: 1px solid rgba(247, 147, 26, 0.1);
	}

	.logo-cards {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.logo-card {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(247, 147, 26, 0.15);
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.logo-card:hover {
		background: rgba(247, 147, 26, 0.08);
		border-color: var(--primary);
		transform: translateY(-3px);
	}

	.logo-img {
		max-height: 28px;
		max-width: 100%;
		object-fit: contain;
	}

	.action-cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.action-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem 0.75rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(247, 147, 26, 0.15);
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.action-card:hover {
		background: rgba(247, 147, 26, 0.08);
		border-color: var(--primary);
		transform: translateY(-3px);
	}

	.card-icon {
		font-size: 1.75rem;
		line-height: 1;
	}

	.card-icon-img {
		height: 3.5rem;
		width: 3.5rem;
		object-fit: contain;
	}

	.card-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text);
	}

	/* Event banner */
	.event-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		background: rgba(247, 147, 26, 0.05);
		border-radius: 8px;
		border: 1px solid rgba(247, 147, 26, 0.15);
	}

	.event-main {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.event-main:hover {
		opacity: 0.85;
	}

	.event-logo {
		height: 2.5rem;
		width: auto;
		object-fit: contain;
		flex-shrink: 0;
	}

	.event-info {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.event-name {
		font-size: 0.9rem;
		font-weight: 700;
		color: #fff;
	}

	.event-date {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--primary);
		background: rgba(247, 147, 26, 0.1);
		padding: 0.15rem 0.55rem;
		border-radius: 4px;
	}

	.event-discount {
		font-size: 0.78rem;
		font-weight: 600;
		color: rgba(204, 204, 204, 0.75);
	}

	.event-more {
		font-size: 0.8rem;
		font-weight: 500;
		color: rgba(204, 204, 204, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
		flex-shrink: 0;
	}

	.event-more:hover {
		color: var(--primary);
	}

	@media (max-width: 768px) {
		.logo-cards {
			grid-template-columns: repeat(3, 1fr);
		}

		.action-cards {
			grid-template-columns: repeat(2, 1fr);
		}

		.event-banner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}

		.event-info {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}
	}
</style>
