---
interface Props {
	lang?: "da" | "en";
}
const { lang = "da" } = Astro.props;
const isEn = lang === "en";
const L = isEn
	? {
			blockHeight: "Block height:",
			epoch: "Epoch:",
			blocksToNext: "Blocks to next epoch:",
			blockReward: "Block reward:",
			satVB: "sat/vB:",
			satsPerDkk: "Sats per DKK:",
		}
	: {
			blockHeight: "Blokhøjde:",
			epoch: "Epoke:",
			blocksToNext: "Blokke til næste epoke:",
			blockReward: "Blokbelønning:",
			satVB: "sat/vB:",
			satsPerDkk: "Sats pr. DKK:",
		};
---

<section class="stats-bar" data-lang={lang}>
	<div class="container">
		<div class="stats-track">
			<!-- First set of stats -->
			<div class="stats-items">
				<div class="stat-item">
					<span class="stat-label">{L.blockHeight}</span>
					<span class="stat-value" id="block-height">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.epoch}</span>
					<span class="stat-value" id="epoch">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.blocksToNext}</span>
					<span class="stat-value" id="blocks-remaining">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.blockReward}</span>
					<span class="stat-value" id="block-reward">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.satVB}</span>
					<span class="stat-value fee-values">
						<span class="fee-item">
							<span class="fee-label">L:</span>
							<span id="fee-low">—</span>
						</span>
						<span class="fee-divider">|</span>
						<span class="fee-item">
							<span class="fee-label">M:</span>
							<span id="fee-medium">—</span>
						</span>
						<span class="fee-divider">|</span>
						<span class="fee-item">
							<span class="fee-label">H:</span>
							<span id="fee-high">—</span>
						</span>
					</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.satsPerDkk}</span>
					<span class="stat-value" id="sats-per-dkk">—</span>
				</div>
			</div>
			<!-- Duplicate set for seamless loop on mobile -->
			<div class="stats-items stats-duplicate" aria-hidden="true">
				<div class="stat-item">
					<span class="stat-label">{L.blockHeight}</span>
					<span class="stat-value" data-mirror="block-height">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.epoch}</span>
					<span class="stat-value" data-mirror="epoch">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.blocksToNext}</span>
					<span class="stat-value" data-mirror="blocks-remaining"
						>—</span
					>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.blockReward}</span>
					<span class="stat-value" data-mirror="block-reward">—</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.satVB}</span>
					<span class="stat-value fee-values">
						<span class="fee-item">
							<span class="fee-label">L:</span>
							<span data-mirror="fee-low">—</span>
						</span>
						<span class="fee-divider">|</span>
						<span class="fee-item">
							<span class="fee-label">M:</span>
							<span data-mirror="fee-medium">—</span>
						</span>
						<span class="fee-divider">|</span>
						<span class="fee-item">
							<span class="fee-label">H:</span>
							<span data-mirror="fee-high">—</span>
						</span>
					</span>
				</div>
				<div class="stat-item">
					<span class="stat-label">{L.satsPerDkk}</span>
					<span class="stat-value" data-mirror="sats-per-dkk">—</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.stats-bar {
		background: transparent;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		padding: 0.3rem 0;
		margin-top: -1rem;
		margin-bottom: 1rem;
		line-height: 1;
		overflow: hidden;
	}

	.stats-bar .container {
		overflow: hidden;
	}

	.stats-track {
		display: flex;
	}

	.stats-items {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: nowrap;
		flex-shrink: 0;
	}

	/* Hide duplicate on desktop */
	.stats-duplicate {
		display: none;
	}

	.stat-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		white-space: nowrap;
		flex-shrink: 0;
		line-height: 1;
	}

	.stat-label {
		color: rgba(255, 255, 255, 0.3);
		font-weight: 500;
		flex-shrink: 0;
	}

	.stat-value {
		color: rgba(255, 255, 255, 0.4);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		transition: color 0.3s ease;
	}

	.stat-value.new-block {
		color: #f7931a !important;
	}

	.fee-values {
		display: flex;
		gap: 0.4rem;
		align-items: center;
	}

	.fee-item {
		display: flex;
		gap: 0.2rem;
	}

	.fee-label {
		font-weight: 500;
		font-size: 0.9em;
	}

	.fee-divider {
		opacity: 0.3;
		padding: 0 0.2rem;
	}

	@media (max-width: 1200px) {
		.stat-item {
			font-size: 0.75rem;
		}
	}

	@media (max-width: 1024px) {
		.stats-bar .container {
			max-width: 100%;
			padding: 0;
		}

		.stats-track {
			width: max-content;
			animation: ticker 35s linear infinite;
		}

		.stats-items {
			gap: 2.5rem;
			padding: 0 1.25rem;
		}

		.stats-duplicate {
			display: flex;
		}

		.stat-item {
			font-size: 0.72rem;
		}
	}

	@keyframes ticker {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}
</style>

<script>
	// Read locale from DOM (no define:vars) — same pattern as ShowcaseGrid; avoids bundling edge cases.
	const root = document.querySelector(".stats-bar[data-lang]");
	const pageLang = (root && root.getAttribute("data-lang")) || "da";
	const locale = pageLang === "en" ? "en-US" : "da-DK";
	let previousBlockHeight: number | null = null;

	function getBlockReward(blockHeight: number): string {
		const halvings = Math.floor(blockHeight / 210000);
		const reward = 50 / Math.pow(2, halvings);
		return reward.toFixed(reward % 1 === 0 ? 0 : 3) + " BTC";
	}

	// Sync duplicate values with originals
	function syncMirrors() {
		document.querySelectorAll("[data-mirror]").forEach((el) => {
			const sourceId = el.getAttribute("data-mirror");
			const source = document.getElementById(sourceId!);
			if (source) {
				el.textContent = source.textContent;
			}
		});
	}

	async function fetchStats() {
		try {
			const blockResponse = await fetch(
				"https://mempool.space/api/blocks/tip/height",
			);
			if (!blockResponse.ok) throw new Error("block height fetch failed");
			const blockHeight = await blockResponse.json();

			const epoch = Math.floor(blockHeight / 210000) + 1;
			const blocksRemaining = 210000 - (blockHeight % 210000);

			const feesResponse = await fetch(
				"https://mempool.space/api/v1/fees/recommended",
			);
			if (!feesResponse.ok) throw new Error("fees fetch failed");
			const feesData = await feesResponse.json();

			const blockHeightElement = document.getElementById("block-height")!;
			if (
				previousBlockHeight !== null &&
				blockHeight > previousBlockHeight
			) {
				blockHeightElement.classList.add("new-block");
				setTimeout(() => {
					blockHeightElement.classList.remove("new-block");
				}, 3000);
			}
			previousBlockHeight = blockHeight;

			const formattedBlockHeight = blockHeight.toLocaleString(locale);
			blockHeightElement.textContent = formattedBlockHeight;

			const footerBlock = document.getElementById("footer-block-height");
			if (footerBlock) footerBlock.textContent = formattedBlockHeight;

			document.getElementById("epoch")!.textContent = epoch.toString();
			document.getElementById("blocks-remaining")!.textContent =
				blocksRemaining.toLocaleString(locale);
			document.getElementById("block-reward")!.textContent =
				getBlockReward(blockHeight);
			document.getElementById("fee-low")!.textContent =
				feesData.hourFee.toString();
			document.getElementById("fee-medium")!.textContent =
				feesData.halfHourFee.toString();
			document.getElementById("fee-high")!.textContent =
				feesData.fastestFee.toString();

			// BTC price (DKK) via server-side proxy to avoid CORS and rate limits.
			try {
				const priceResponse = await fetch("/.netlify/functions/btc-price");
				if (!priceResponse.ok) throw new Error("price fetch failed");
				const priceData = await priceResponse.json();
				const btcPriceDKK = Number(priceData?.dkk);
				if (!Number.isFinite(btcPriceDKK) || btcPriceDKK <= 0) {
					throw new Error("invalid price payload");
				}
				const satsPerDKK = Math.floor(100000000 / btcPriceDKK);
				document.getElementById("sats-per-dkk")!.textContent =
					satsPerDKK.toLocaleString(locale);
			} catch (priceError) {
				console.warn("Price fetch error:", priceError);
				const el = document.getElementById("sats-per-dkk");
				if (el) el.textContent = "N/A";
			}

			// Sync the duplicate set
			syncMirrors();
		} catch (error) {
			console.error("Stats fetch error:", error);
			[
				"block-height",
				"epoch",
				"blocks-remaining",
				"block-reward",
				"fee-low",
				"fee-medium",
				"fee-high",
				"sats-per-dkk",
			].forEach((id) => {
				const element = document.getElementById(id);
				if (element) element.textContent = "N/A";
			});
			const footerBlock = document.getElementById("footer-block-height");
			if (footerBlock) footerBlock.textContent = "N/A";
			syncMirrors();
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", fetchStats);
	} else {
		fetchStats();
	}

	setInterval(fetchStats, 120000);
</script>
