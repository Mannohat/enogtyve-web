---
import { localizedHref } from "../../i18n/routes";
import { Image } from 'astro:assets';
interface Props {
	lang: "da" | "en";
}
const { lang } = Astro.props;
const isEn = lang === "en";
---

<section class="featured">
	<h2>{isEn ? "Explore" : "Udforsk"}</h2>
	<div class="feature-grid">
		<a href={localizedHref(`/da/blog`, lang)} class="feature-card">
			<Image src="/images/icons/blog.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>Blog</h3>
			<p>
				{isEn
					? "Articles and blog posts (mostly Danish)"
					: "Artikler og blogindlæg"}
			</p>
		</a>

		<a href={localizedHref(`/da/podcasts`, lang)} class="feature-card">
			<Image src="/images/icons/podcasts.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>Podcasts</h3>
			<p>
				{isEn
					? "Danish Bitcoin podcasts"
					: "Liste over danske Bitcoin Podcasts"}
			</p>
		</a>

		<a href={localizedHref(`/da/udforsk/udforsk`, lang)} class="feature-card">
			<Image src="/images/icons/udforsk.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>{isEn ? "Explore" : "Udforsk"}</h3>
			<p>
				{isEn
					? "Communities, meetups, and conferences"
					: "Fællesskaber, meetups og konferencer"}
			</p>
		</a>

		<a href={localizedHref(`/da/kom-igang/kob-bitcoin`, lang)} class="feature-card">
			<Image src="/images/icons/komigang.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>{isEn ? "Get started" : "Kom igang"}</h3>
			<p>
				{isEn
					? "Learn how to acquire and store bitcoin"
					: "Lær at anskaffe og opbevare bitcoin"}
			</p>
		</a>

		<a href={localizedHref(`/da/rabat`, lang)} class="feature-card">
			<Image src="/images/icons/promo.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>{isEn ? "Discounts with enogtyve" : "Rabat med enogtyve"}</h3>
			<p>
				{isEn
					? "Save money with our partners"
					: "Spar penge med vores partnere"}
			</p>
		</a>

		<a href={localizedHref(`/da/faellesskab/support`, lang)} class="feature-card">
			<Image src="/images/icons/support.png" alt="" width={1024} height={1024} class="feature-icon" />
			<h3>{isEn ? "Support us" : "Støt os"}</h3>
			<p>
				{isEn
					? "Help the community grow"
					: "Hjælp fællesskabet med at vokse"}
			</p>
		</a>
	</div>

	<a href={isEn ? "https://nostr.dk/en" : "https://nostr.dk"} target="_blank" rel="noopener noreferrer" class="nostr-banner">
		<Image src="/images/logos/nostrdk.png" alt="Nostr.dk" width={512} height={512} class="nostr-icon" />
		<div class="nostr-text">
			<h3>
				{isEn
					? "Take part in the decentralized internet of the future"
					: "Tag del i fremtidens decentraliserede internet"}
			</h3>
			<p>
				{isEn
					? "Nostr gives you ownership of your data – an open protocol for social media and much more."
					: "Nostr giver dig ejerskab over dine data – en åben protokol for sociale medier og meget mere."}
			</p>
		</div>
		<span class="nostr-cta">{isEn ? "Visit Nostr.dk →" : "Besøg Nostr.dk →"}</span>
	</a>
</section>

<style>
	.featured {
		padding: clamp(2.5rem, 6vh, 4rem) 0;
	}

	.featured h2 {
		text-align: center;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		margin-bottom: clamp(1.75rem, 5vh, 3rem);
		font-weight: 600;
		color: var(--text);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: clamp(1.25rem, 3vw, 1.75rem);
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.feature-card {
		padding: clamp(1.5rem, 4vw, 2rem);
		border: 1px solid rgba(247, 147, 26, 0.2);
		border-radius: 12px;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		text-align: center;
		background: rgba(255, 255, 255, 0.01);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 140px;
		text-decoration: none;
	}

	.feature-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(
			circle at center,
			rgba(247, 147, 26, 0.05),
			transparent
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.feature-card:hover::before,
	.feature-card:focus::before {
		opacity: 1;
	}

	.feature-card:hover,
	.feature-card:focus {
		border-color: var(--primary);
		transform: translateY(-6px);
		box-shadow: 0 12px 24px rgba(247, 147, 26, 0.15);
		background: rgba(247, 147, 26, 0.03);
	}

	.feature-card h3 {
		color: var(--text);
		margin-bottom: 0.65rem;
		font-size: clamp(1.05rem, 2.5vw, 1.2rem);
		font-weight: 600;
		position: relative;
	}

	.feature-card p {
		color: var(--text-light);
		margin: 0;
		font-size: clamp(0.88rem, 2vw, 0.95rem);
		line-height: 1.5;
		position: relative;
	}
	.feature-icon {
		height: 3.5rem;
		width: 3.5rem;
		object-fit: contain;
		margin-bottom: 0.5rem;
	}

	.nostr-banner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		width: calc(100% - 2rem);
		max-width: calc(1200px - 2rem);
		margin: clamp(1rem, 2.5vw, 1.5rem) auto 0;
		padding: clamp(1.1rem, 3vw, 1.5rem) clamp(1.25rem, 3.5vw, 2rem);
		border: 1px solid rgba(109, 64, 217, 0.35);
		border-radius: 12px;
		background: rgba(109, 64, 217, 0.07);
		text-decoration: none;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.nostr-banner:hover {
		border-color: rgba(139, 92, 246, 0.7);
		background: rgba(109, 64, 217, 0.13);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
	}

	.nostr-icon {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 10px;
		animation: nostr-pulse 2.6s ease-in-out infinite;
	}

	@keyframes nostr-pulse {
		0%,
		100% {
			transform: scale(1);
			box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.45);
		}
		50% {
			transform: scale(1.06);
			box-shadow: 0 0 0 10px rgba(139, 92, 246, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nostr-icon {
			animation: none;
		}
	}

	.nostr-text {
		flex: 1;
	}

	.nostr-text h3 {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 0.25rem 0;
	}

	.nostr-text p {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-light);
		margin: 0;
	}

	.nostr-cta {
		flex-shrink: 0;
		font-weight: 600;
		font-size: 0.95rem;
		color: #a78bfa;
		white-space: nowrap;
	}

	@media (max-width: 767px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}

		.nostr-banner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
