---
import "../styles/global.css";
import "../styles/support-modal.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { daToEn, enToDa, EN_LIVE, localizedHref } from "../i18n/routes";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogType?: "website" | "article";
    pubDate?: Date;
    author?: string;
    lang?: "da" | "en";
}

const {
    title,
    description = "Enogtyve er Danmarks Bitcoin-fællesskab. Lær om Bitcoin, Lightning Network, opbevaring og meget mere.",
    ogImage,
    ogType = "website",
    pubDate,
    author,
    lang = "da",
} = Astro.props;

// Default social-share card (1200x630), language-aware. Pages/posts may
// override it via the `ogImage` prop (e.g. a custom blog image).
const usingDefaultCard = !ogImage;
const resolvedOgImage =
    ogImage ??
    (lang === "en"
        ? "https://enogtyve.org/images/og/enogtyve-og-en.png"
        : "https://enogtyve.org/images/og/enogtyve-og.png");

const canonicalURL = new URL(
    Astro.url.pathname,
    "https://enogtyve.org",
).toString();

/**
 * Resolve da/en alternate URLs from the route registry. Works whether the
 * current page is Danish or English: normalize to the Danish tail, then look up
 * the English counterpart. Unprefixed routes (e.g. /404) get no alternates.
 */
const pathnameNormalized = Astro.url.pathname.replace(/\.html$/, "");
const localeMatch = pathnameNormalized.match(/^\/(da|en)(\/.*|$)/);
const currentLang = localeMatch ? (localeMatch[1] as "da" | "en") : null;
const tail =
    ((localeMatch ? localeMatch[2] || "/" : pathnameNormalized) || "/").replace(
        /\/$/,
        "",
    ) || "/";

const daTail = currentLang === "en" ? enToDa[tail] ?? tail : tail;
const enTail = daToEn[daTail];

const daPath = !localeMatch
    ? "https://enogtyve.org/da"
    : `https://enogtyve.org/da${daTail === "/" ? "" : daTail}`;
const hasEnVersion = !!enTail && EN_LIVE.has(enTail);
const enPath = enTail
    ? `https://enogtyve.org/en${enTail === "/" ? "" : enTail}`
    : "https://enogtyve.org/en";

// Organization entity — referenced by @id from the page entity and linked to
// the official channels via sameAs (helps Google build the brand entity).
const ORG_ID = "https://enogtyve.org/#organization";
const organization = {
    "@type": "Organization",
    "@id": ORG_ID,
    "name": "Enogtyve",
    "url": "https://enogtyve.org",
    "description":
        lang === "da" ? "Danmarks Bitcoin-fællesskab" : "Denmark's bitcoin community",
    "logo": {
        "@type": "ImageObject",
        "url": "https://enogtyve.org/images/logos/enogtyve_logo.png",
    },
    "sameAs": [
        "https://primal.net/p/nprofile1qqst6yvd9dm3wmzlpzjza3fuzev8x83unenzus9c697jk6mzxfq9jugtpeyeh",
        "https://t.me/enogtyvedk",
        "https://youtube.com/@enogtyvedanmark",
        "https://github.com/Mannohat/enogtyve-web",
    ],
};

const pageEntity = ogType === "article" && pubDate
    ? {
          "@type": "Article",
          "headline": title,
          "description": description,
          "url": canonicalURL,
          "datePublished": pubDate.toISOString(),
          ...(author ? { "author": { "@type": "Person", "name": author } } : {}),
          "publisher": { "@id": ORG_ID },
          "image": resolvedOgImage,
          "inLanguage": lang === "da" ? "da-DK" : "en-US",
      }
    : {
          "@type": "WebSite",
          "@id": "https://enogtyve.org/#website",
          "name": "Enogtyve",
          "url": "https://enogtyve.org",
          "description": description,
          "publisher": { "@id": ORG_ID },
          "inLanguage": lang === "da" ? "da-DK" : "en-US",
      };

// Breadcrumb (Home › Section › Page). Keyed off the Danish tail so it works in
// both languages; section URLs go through localizedHref so they never 404.
const SECTION_CRUMBS: Record<string, { da: string; en: string; href: string }> = {
    "kom-igang": { da: "Kom i gang", en: "Get started", href: "/da/kom-igang/guide" },
    "laer-mere": { da: "Lær mere", en: "Learn", href: "/da/laer-mere/bitcoin-blockchain" },
    "udforsk": { da: "Udforsk", en: "Explore", href: "/da/udforsk/udforsk" },
    "mining": { da: "Mining", en: "Mining", href: "/da/mining/mining-for-opvarmning" },
    "faellesskab": { da: "Fællesskab", en: "Community", href: "/da/faellesskab/bookmarks" },
    "blog": { da: "Blog", en: "Blog", href: "/da/blog" },
    "podcasts": { da: "Podcasts", en: "Podcasts", href: "/da/podcasts" },
};

const daSegs = daTail.split("/").filter(Boolean);
let breadcrumb = null;
if (localeMatch && tail !== "/") {
    const crumbs: { name: string; url: string }[] = [
        { name: lang === "en" ? "Home" : "Forside", url: `https://enogtyve.org/${lang}/` },
    ];
    const sec = SECTION_CRUMBS[daSegs[0]];
    if (sec && daSegs.length > 1 && sec.href.replace(/^\/da/, "") !== daTail) {
        crumbs.push({
            name: sec[lang],
            url: `https://enogtyve.org${localizedHref(sec.href, lang)}/`,
        });
    }
    crumbs.push({ name: title, url: canonicalURL });
    breadcrumb = {
        "@type": "BreadcrumbList",
        "itemListElement": crumbs.map((c, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": c.name,
            "item": c.url,
        })),
    };
}

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [organization, pageEntity, ...(breadcrumb ? [breadcrumb] : [])],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#F7931A" />
        <title>{title} | Enogtyve</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="preconnect" href="https://cloud.umami.is" />
        <link rel="preconnect" href="https://btcpay.ideasarelikeflames.org" />
        <link rel="preconnect" href="https://mempool.space" />

        <!-- hreflang -->
        <link rel="alternate" hreflang="da" href={daPath} />
        {hasEnVersion && <link rel="alternate" hreflang="en" href={enPath} />}
        {hasEnVersion && <link rel="alternate" hreflang="x-default" href={daPath} />}

        <!-- Open Graph -->
        <meta property="og:title" content={`${title} | Enogtyve`} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={resolvedOgImage} />
        {usingDefaultCard && <meta property="og:image:width" content="1200" />}
        {usingDefaultCard && <meta property="og:image:height" content="630" />}
        {usingDefaultCard && <meta property="og:image:type" content="image/png" />}
        <meta
            property="og:image:alt"
            content={lang === "en"
                ? "Enogtyve – Denmark's bitcoin community"
                : "Enogtyve – Danmarks bitcoin-fællesskab"}
        />
        <meta
            property="og:locale"
            content={lang === "da" ? "da_DK" : "en_US"}
        />
        <meta property="og:site_name" content="Enogtyve" />
        {ogType === "article" && pubDate && (
            <meta property="article:published_time" content={pubDate.toISOString()} />
        )}
        {ogType === "article" && author && (
            <meta property="article:author" content={author} />
        )}

        <!-- Twitter/X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${title} | Enogtyve`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={resolvedOgImage} />
        <meta
            name="twitter:image:alt"
            content={lang === "en"
                ? "Enogtyve – Denmark's bitcoin community"
                : "Enogtyve – Danmarks bitcoin-fællesskab"}
        />

        <!-- JSON-LD -->
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <!-- Umami Analytics -->
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="ab69f237-947e-44f2-972f-ccdba2c4cd19"></script>
    </head>
    <body>
        <a href="#main" class="skip-link">{lang === "en" ? "Skip to content" : "Spring til indhold"}</a>

        <Header lang={lang} />

        <main id="main">
            <slot />
        </main>

        <Footer lang={lang} />

        {lang === "en" && (
            <div
                id="ai-translation-toast"
                class="ai-translation-toast"
                role="status"
                aria-live="polite"
            >
                <span class="ai-translation-toast__icon" aria-hidden="true">🌐</span>
                <span>Heads up: the English pages are translated with AI. The Danish version is the original.</span>
            </div>
        )}

        {lang === "en" && (
            <script is:inline>
                (function () {
                    var KEY = "en-ai-translation-notice";
                    try {
                        if (localStorage.getItem(KEY) === "shown") return;
                    } catch (e) {}
                    var el = document.getElementById("ai-translation-toast");
                    if (!el) return;
                    requestAnimationFrame(function () {
                        el.classList.add("is-visible");
                    });
                    setTimeout(function () {
                        el.classList.remove("is-visible");
                    }, 4000);
                    try {
                        localStorage.setItem(KEY, "shown");
                    } catch (e) {}
                })();
            </script>
        )}

        <!-- Support Modal -->
        <div
            class="support-overlay"
            id="supportOverlay"
        >
            <div
                class="support-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="supportModalTitle"
            >
                <button class="close-btn" id="supportCloseBtn">&times;</button>

                <div class="icon-wrap">🧡</div>
                <h2 id="supportModalTitle">Proof of Heart</h2>
                <p class="subtitle">{lang === "en" ? "Thank you for your support!" : "Tak for din opbakning!"}</p>

                <div class="divider"></div>

                <div class="btcpay-wrap">
                    <div class="amount-label">{lang === "en" ? "Choose an amount" : "Vælg beløb"}</div>

                    <form
                        method="POST"
                        action="https://btcpay.ideasarelikeflames.org/api/v1/invoices"
                        class="btcpay-form btcpay-form--block"
                    >
                        <input
                            type="hidden"
                            name="storeId"
                            value="GL4Us2RE6nDJhwXMUMgagN9efPYpMs1ebZwx9MxQG3qN"
                        />
                        <input
                            type="hidden"
                            name="browserRedirect"
                            value="https://www.enogtyve.org"
                        />
                        <div class="btcpay-custom-container">
                            <div class="btcpay-custom">
                                <button
                                    class="plus-minus"
                                    type="button"
                                    data-type="-"
                                    data-step="21"
                                    data-min="21"
                                    data-max="21000">−</button
                                >
                                <input
                                    class="btcpay-input-price"
                                    type="number"
                                    name="price"
                                    min="21"
                                    max="21000"
                                    step="21"
                                    value="21"
                                    data-price="21"
                                />
                                <button
                                    class="plus-minus"
                                    type="button"
                                    data-type="+"
                                    data-step="21"
                                    data-min="21"
                                    data-max="21000">+</button
                                >
                            </div>
                            <select name="currency">
                                <option value="DKK" selected>DKK</option>
                                <option value="USD">USD</option>
                                <option value="GBP">GBP</option>
                                <option value="EUR">EUR</option>
                                <option value="BTC">BTC</option>
                            </select>
                        </div>
                        <button
                            type="submit"
                            class="submit"
                            name="submit"
                            title="Pay with BTCPay Server, a Self-Hosted Bitcoin Payment Processor"
                        >
                            <span>{lang === "en" ? "Contribute with" : "Bidrag med"}</span>
                            <img
                                src="https://btcpay.ideasarelikeflames.org/img/paybutton/logo.svg"
                                alt="BTCPay"
                            />
                        </button>
                    </form>
                </div>

                <span class="footnote">{lang === "en" ? "Powered by BTCPay Server" : "Drevet af BTCPay Server"}</span>
            </div>
        </div>
        <script is:inline>
            function openSupport() {
                const overlay = document.getElementById("supportOverlay");
                overlay.classList.add("active");
                // Store previously focused element and move focus into modal
                overlay._previousFocus = document.activeElement;
                document.getElementById("supportCloseBtn").focus();
                // Trap focus inside modal
                overlay.addEventListener("keydown", trapFocus);
            }

            function closeSupport(e) {
                if (!e || e.target === e.currentTarget) {
                    const overlay = document.getElementById("supportOverlay");
                    overlay.classList.remove("active");
                    overlay.removeEventListener("keydown", trapFocus);
                    // Restore focus
                    if (overlay._previousFocus) overlay._previousFocus.focus();
                }
            }

            function trapFocus(e) {
                if (e.key !== "Tab") return;
                const modal = document.querySelector(".support-modal");
                const focusable = modal.querySelectorAll(
                    'button, input, select, [tabindex]:not([tabindex="-1"])'
                );
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (e.shiftKey) {
                    if (document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    }
                } else {
                    if (document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            }

            document.getElementById("supportOverlay").addEventListener("click", closeSupport);
            document.getElementById("supportCloseBtn").addEventListener("click", () => closeSupport());

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") closeSupport();
            });

            document
                .querySelectorAll(".btcpay-form .plus-minus")
                .forEach(function (el) {
                    el.addEventListener("click", function (event) {
                        event.preventDefault();
                        const root = event.target.closest(".btcpay-form");
                        const input = root.querySelector(".btcpay-input-price");
                        const step = parseInt(event.target.dataset.step) || 1;
                        const min = parseInt(event.target.dataset.min) || 1;
                        const max = parseInt(event.target.dataset.max);
                        const type = event.target.dataset.type;
                        const price = parseInt(input.value) || min;
                        if (type === "-") {
                            input.value = price - step < min ? min : price - step;
                        } else if (type === "+") {
                            input.value = price + step > max ? max : price + step;
                        }
                    });
                });

            document
                .querySelectorAll(".btcpay-form .btcpay-input-price")
                .forEach(function (el) {
                    el.addEventListener("input", function (event) {
                        event.preventDefault();
                        const price = parseInt(event.target.dataset.price);
                        if (isNaN(event.target.value)) event.target.value = price;
                        const min = parseInt(event.target.getAttribute("min")) || 1;
                        const max = parseInt(event.target.getAttribute("max"));
                        if (event.target.value < min) event.target.value = min;
                        else if (event.target.value > max) event.target.value = max;
                    });
                });
        </script>
    </body>
</html>

<style>
    main {
        min-height: 70vh;
        padding: var(--space-sm) 0;
    }

    /* One-time AI-translation notice (English pages only) */
    .ai-translation-toast {
        position: fixed;
        left: 50%;
        top: 1.25rem;
        z-index: 1100;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        max-width: min(92vw, 460px);
        padding: 0.7rem 1rem;
        background: rgba(20, 20, 20, 0.96);
        border: 1px solid rgba(247, 147, 26, 0.4);
        border-radius: 10px;
        color: #eee;
        font-size: 0.85rem;
        line-height: 1.4;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%) translateY(-0.6rem);
        transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .ai-translation-toast.is-visible {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    .ai-translation-toast__icon {
        flex-shrink: 0;
        font-size: 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .ai-translation-toast {
            transition: opacity 0.01s linear;
            transform: translateX(-50%) translateY(0);
        }
    }

    .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        background: var(--primary);
        color: #000;
        font-weight: 700;
        padding: 0.5rem 1rem;
        border-radius: 0 0 8px 8px;
        z-index: 9999;
        transition: top 0.2s ease;
    }

    .skip-link:focus {
        top: 0;
    }
</style>